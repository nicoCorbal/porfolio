---
import Layout from '../../layouts/Layout.astro';
import SimpleFooter from '../../components/SimpleFooter.astro';


export async function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;

// Datos del proyecto (podrías moverlos a un JSON común si lo deseas)
const translations = {
  es: {
    project: {
      title: 'Wearendar',
      subtitle: 'La app que fusiona tu armario con el clima.',
      category: 'App Móvil',
      client: 'Wearendar Inc.',
      year: '2023',
      awards: ['Premio a la Innovación App del Año'],
      challenge:
        'Crear una experiencia de usuario fluida que integre la planificación de eventos con la selección de vestimenta, manteniendo un diseño intuitivo y accesible para usuarios de todas las edades.',
      solution:
        'Desarrollamos una aplicación nativa con algoritmos de machine learning para recomendaciones personalizadas, integración con APIs de clima, y una interfaz de usuario minimalista que prioriza la usabilidad.',
      description: 'Una aplicación móvil inteligente que combina la gestión de calendario con recomendaciones personalizadas de vestimenta. Wearendar analiza tus eventos programados y sugiere outfits apropiados basados en el tipo de evento, clima y tus preferencias personales.',
      technologies: ['React Native', 'TypeScript', 'Node.js', 'MongoDB', 'Weather API', 'Machine Learning'],
      features: [
        'Calendario inteligente con gestión de eventos',
        'Recomendaciones de outfit basadas en IA',
        'Integración con pronóstico del tiempo',
        'Guardarropa digital personalizable',
        'Notificaciones push inteligentes',
        'Sincronización multiplataforma',
      ],
      images: ['/wearendar.jpeg', '/wearendar.jpeg'],
      liveUrl: 'https://wearendar.app',
      githubUrl: 'https://github.com/osixtech/wearendar',
    },
    clientLabel: 'Cliente',
    yearLabel: 'Año',
    projectDescriptionTitle: 'Descripción del Proyecto',
    challengeTitle: 'Reto',
    solutionTitle: 'Solución',
    technologiesTitle: 'Tecnologías Utilizadas',
    galleryTitle: 'Galería del Proyecto',
    featuresTitle: 'Características Principales',
    ctaTitle: '¿Listo para empezar tu proyecto?',
    ctaDescription: 'Contáctanos para una consulta gratuita y descubre cómo podemos ayudarte a alcanzar tus objetivos.',
    contactButton: 'Contactar',
    viewMoreButton: 'Ver Más Proyectos',
    viewProjectButton: 'Ver Proyecto',
    codeButton: 'Código',
  },
  en: {
    project: {
      title: 'Wearendar',
      subtitle: 'The app that merges your wardrobe with the weather.',
      category: 'Mobile App',
      client: 'Wearendar Inc.',
      year: '2023',
      awards: ['App of the Year Innovation Award'],
      challenge:
        'To create a seamless user experience that integrates event planning with outfit selection, maintaining an intuitive and accessible design for users of all ages.',
      solution:
        'We developed a native application with machine learning algorithms for personalized recommendations, integration with weather APIs, and a minimalist user interface that prioritizes usability.',
      description: 'An intelligent mobile application that combines calendar management with personalized clothing recommendations. Wearendar analyzes your scheduled events and suggests appropriate outfits based on the event type, weather, and your personal preferences.',
      technologies: ['React Native', 'TypeScript', 'Node.js', 'MongoDB', 'Weather API', 'Machine Learning'],
      features: [
        'Smart calendar with event management',
        'AI-based outfit recommendations',
        'Weather forecast integration',
        'Customizable digital wardrobe',
        'Intelligent push notifications',
        'Cross-platform synchronization',
      ],
      images: ['/wearendar.jpeg', '/wearendar.jpeg'],
      liveUrl: 'https://wearendar.app',
      githubUrl: 'https://github.com/osixtech/wearendar',
    },
    clientLabel: 'Client',
    yearLabel: 'Year',
    projectDescriptionTitle: 'Project Description',
    challengeTitle: 'Challenge',
    solutionTitle: 'Solution',
    technologiesTitle: 'Technologies Used',
    galleryTitle: 'Project Gallery',
    featuresTitle: 'Main Features',
    ctaTitle: 'Ready to start your project?',
    ctaDescription: 'Contact us for a free consultation and find out how we can help you achieve your goals.',
    contactButton: 'Contact',
    viewMoreButton: 'View More Projects',
    viewProjectButton: 'View Project',
    codeButton: 'Code',
  },
};

const content = translations[lang as keyof typeof translations];
const project = content.project;

const title = `${project.title} – Proyecto`;
const pageDescription = project.subtitle;
const image = project.images[0];

---

<Layout {title} description={pageDescription} {image} lang={lang}>
  
  {/* HERO */}
  <section class="py-28 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="flex items-center flex-wrap gap-4 mb-6">
            <span class="px-3 py-1 rounded-full bg-gray-100 text-gray-800 text-sm">{content.project.category}</span>
            {project.awards.map((award) => (
              <span class="px-3 py-1 rounded-full border border-yellow-400 text-yellow-700 text-sm" set:html={`🏆 ${award}`}></span>
            ))}
          </div>

          <h1 class="text-4xl lg:text-6xl font-bold text-black mb-4">{project.title}</h1>
          <p class="text-xl text-gray-600 mb-8">{project.subtitle}</p>

          <div class="grid grid-cols-2 gap-6 mb-8 text-left">
            <div>
              <p class="text-sm text-gray-500 mb-1">{content.clientLabel}</p>
              <p class="font-medium text-black">{project.client}</p>
            </div>
            <div>
              <p class="text-sm text-gray-500 mb-1">{content.yearLabel}</p>
              <p class="font-medium text-black">{project.year}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-4">
                        <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center bg-black hover:bg-gray-800 text-white px-5 py-3 rounded-lg text-sm">
              {content.viewProjectButton}
            </a>
                        <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center border border-gray-300 hover:bg-gray-100 text-black px-5 py-3 rounded-lg text-sm">
              {content.codeButton}
            </a>
          </div>
        </div>

        <div class="flex justify-center lg:justify-end">
          <div class="w-96 h-80 rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200">
            <img src={project.images[0]} alt={project.title} class="object-cover w-full h-full" />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* DESCRIPCIÓN */}
  <section class="py-16 bg-gray-50 mb-6">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-black mb-4">{content.projectDescriptionTitle}</h2>
          <p class="text-gray-600 leading-relaxed">{project.description}</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold text-black mb-3">{content.challengeTitle}</h3>
          <p class="text-gray-600 leading-relaxed mb-6">{project.challenge}</p>
          <h3 class="text-lg font-semibold text-black mb-2">{content.solutionTitle}</h3>
          <p class="text-gray-600 leading-relaxed">{project.solution}</p>
        </div>
      </div>
    </div>
  </section>

  {/* GALERÍA */}
  <section class="py-16 mb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-black text-center mb-6">{content.galleryTitle}</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {project.images.map((img, idx) => (
          <div class="aspect-[3/4] rounded-xl overflow-hidden bg-gray-100">
            <img src={img} alt={`${project.title} screenshot ${idx + 1}`} class="object-cover w-full h-full" />
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* TECNOLOGÍAS Y FEATURES */}
  <section class="py-16 bg-gray-50 mb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-2xl font-bold text-black flex items-center mb-6">{content.technologiesTitle}</h2>
          <div class="flex flex-wrap gap-3">
            {project.technologies.map((tech) => (
              <span class="px-3 py-1 rounded-full border text-sm">{tech}</span>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-black mb-8">{content.featuresTitle}</h2>
          <ul class="space-y-3 list-disc list-inside marker:text-black">
            {project.features.map((feature) => (
              <li class="text-gray-600">{feature}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-16 mb-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-black mb-4">{content.ctaTitle}</h2>
      <p class="text-lg text-gray-300 mb-8">{content.ctaDescription}</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href="#contact" class="btn-primary">{content.contactButton}</a>
        <a href="/projects" class="btn-secondary">{content.viewMoreButton}</a>
      </div>
    </div>
  </section>
</Layout>

<SimpleFooter lang={lang} />
