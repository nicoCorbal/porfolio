---
import Layout from '../../../layouts/Layout.astro';
import { getProject, getProjectIds } from '../../../data/projects-multilingual';
import LoadingScreen from '../../../components/LoadingScreen.astro';

export const prerender = true;

export async function getStaticPaths() {
  const projectIds = getProjectIds();
  const languages = ['en', 'es'];
  
  return languages.flatMap(lang => 
    projectIds.map(id => ({
      params: { lang, id }
    }))
  );
}

const { id = '', lang = 'en' } = Astro.params;
const project = getProject(id, lang);

if (!project) {
  return Astro.redirect(`/${lang}/404`);
}

// Load translations
const translations = await import(`../../../../public/locales/${lang}.json`);
const t = (key: string) => translations.default[key] || key;
---

<Layout lang={lang}>
  <LoadingScreen duration={1000} />
  
  <section class="hero-section relative min-h-[450px] bg-black lg:min-h-[550px] flex items-center overflow-hidden mb-0">
    <!-- Background Image with Parallax -->
    <div class="hero-bg absolute inset-0 z-0 bg-black">
      <img src={project.images[0]} alt={project.title} class="hero-image object-cover w-full h-full" />
      <div class="hero-gradient absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    </div>    
    <!-- Content -->
    <div class="relative z-10 px-4 sm:px-6 lg:px-10 w-full pt-20">
      <div class="max-w-2xl">
        <div class="hero-badges flex items-center flex-wrap gap-4 mb-6 opacity-0">
          <span class="badge px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm border border-white/30">{project.category}</span>
          {project.awards && project.awards.map((award, index) => (
            <span class="badge px-3 py-1 bg-yellow-400/20 backdrop-blur-sm border border-yellow-400/50 text-yellow-100 text-sm" style={`--badge-index: ${index + 1}`}>🏆 {award}</span>
          ))}
        </div>

        <h1 class="hero-title text-5xl md:text-7xl font-bold text-white mb-3 md:mb-6 opacity-0">{project.title}</h1>
        <h5 class="hero-subtitle text-xl md:text-2xl text-gray-50 mb-8 opacity-0">{project.subtitle}</h5>

        <div class="hero-meta flex flex-row gap-8 mb-8 text-left opacity-0">
          <div class="meta-item">
            <p class="text-sm text-gray-400 mb-1">{t('projects.detail.type')}</p>
            <p class="font-medium text-gray-50">{project.type}</p>
          </div>
          <div class="meta-item">
            <p class="text-sm text-gray-400 mb-1">{t('projects.detail.date')}</p>
            <p class="font-medium text-gray-50">{project.date}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DESCRIPCIÓN -->
  <section class="description-section py-16 bg-white mb-0">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-16">
        
        <!-- CÓMO NACIÓ -->
        <div class="info-card fade-up" style="--delay: 0.1s">
          <h2 class="info-title text-3xl font-bold text-black mb-4">{t('projects.detail.howBorn')} {project.title}</h2>
          <p class="info-text text-gray-900 leading-relaxed text-justify">{project.birth}</p>
        </div>
    
        <!-- CASOS DE USO -->
        <div class="info-card fade-up" style="--delay: 0.3s">
          <h2 class="info-title text-3xl font-bold text-black mb-4">{t('projects.detail.useCases')} {project.title}</h2>
          <ul class="space-y-4">
            {project.usecase.map((item, index) => (
              <li class="use-case-item flex items-start gap-3" style={`--item-index: ${index}`}>
                <svg class="w-5 h-5 text-black mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-800 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
    
        <!-- FUTURO -->
        <div class="info-card fade-up" style="--delay: 0.5s">
          <h2 class="info-title text-3xl font-bold text-black mb-4">{t('projects.detail.future')} {project.title}</h2>
          <p class="info-text text-gray-900 leading-relaxed text-justify">{project.future}</p>
        </div>
    
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="features-section bg-white  py-16 mb-0">
    <div class="w-full mx-auto px-4 sm:px-6 lg:px-10">
      <h2 class="features-title text-3xl font-bold text-black text-left  mb-12 fade-up" style="--delay: 0.6s">{t('projects.detail.features')}</h2>
      <div class={`features-grid grid gap-8 ${
        project.features.length <= 2 ? 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto' :
        project.features.length <= 4 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-2' :
        project.features.length <= 6 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' :
        project.features.length <= 8 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4' :
        'grid-cols-1 md:grid-cols-2 lg:grid-cols-3 '
      }`}>
        {project.features.map((feature, index) => (
          <div class="feature-card group relative min-h-[16rem] w-full overflow-hidden border border-gray-200 fade-scale" style={`--card-index: ${index}`}>
            
            {/* CARD BACK (Hidden Content) */}
            <div class="card-back relative z-10 bg-black bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.04)_0%,transparent_40%)] border border-transparent p-5 text-left text-white">
              <div class="card-back-content opacity-0 transition-all duration-[400ms] delay-200 group-hover:opacity-100">
                <h5 class="mb-4 w-full border-b border-gray-600 pb-4 text-lg font-semibold">
                  {feature.title}
                </h5>
                <p class="text-sm leading-relaxed text-gray-50 opacity-90">
                  {feature.description}
                </p>
              </div>
            </div>

            {/* CARD FRONT (Sliding Panel) */}
            <div class="card-front absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-white p-5 border border-transparent z-2 shadow-[inset_0_0_0_1px_#e5e7eb] transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:-translate-x-full">
              
              {/* Icon Wrapper */}
              <div class="flex h-16 w-16 items-center justify-center bg-black shadow-md transition-transform duration-300 group-hover:scale-110">
                {feature.icon ? (
                  <div class="w-8 h-8 text-white" set:html={feature.icon}></div>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.539 1.118l-3.975-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.539-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                )}
              </div>
              <h4 class="text-lg font-semibold text-black text-center px-2">{feature.title}</h4>
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO DEMO -->
  {project.video && (
    <section class="py-16 mb-0">
      <div class="mx-auto px-4 sm:px-6 lg:px-10">
        <h2 class="text-3xl font-bold text-black text-left  mb-12">{project.title} {t('projects.detail.inAction')}</h2>
         <div class="relative aspect-[16/9] content-fit overflow-hidden bg-black shadow-lg">
          <video
            autoplay
            muted
            loop
            playsinline
            controls
            class="w-full h-full object-cover"
            poster={project.images[1] || project.images[0]}
            preload="metadata"
          >
            <source src={project.video} type="video/mp4" />
            {lang === 'es' ? 'Tu navegador no soporta la reproducción de video.' : 'Your browser does not support video playback.'}
          </video>
        </div>
      </div>
    </section>
  )}


  <!-- CTA -->
  <section class="py-16 bg-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-10 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">{t('projects.detail.interested')}</h2>
      <p class="text-lg text-gray-50 mb-8">{t('projects.detail.contactInfo')}</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href={`/${lang}/#projects`} class="inline-flex text-black  items-center border border-white bg-white hover:bg-black hover:text-white px-6 py-3 text-base font-semibold text-center transition-all duration-300 w-full sm:w-auto">
          {t('projects.detail.viewMore')}
        </a>
        <a href={`/${lang}/#contact`} class="inline-flex items-center border border-white hover:bg-white hover:text-black text-white px-6 py-3 font-semibold text-center transition-all duration-300 w-full sm:w-auto">
          {t('projects.detail.contact')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initializeAnimations = () => {
      // Touch device handling
      const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
      if (isTouchDevice) {
        const featureCards = document.querySelectorAll('.feature-card');
        featureCards.forEach(card => {
          card.addEventListener('click', () => {
            card.classList.toggle('is-flipped');
          });
        });
      }

      // Hero animations on load - Changed to slide in from different directions
      const heroTimeline = () => {
        // Animate hero elements with new effects
        document.querySelector('.hero-image')?.classList.add('animate');
        document.querySelector('.hero-gradient')?.classList.add('animate');
        
        setTimeout(() => {
          document.querySelector('.hero-badges')?.classList.add('animate');
        }, 200);
        
        setTimeout(() => {
          document.querySelector('.hero-title')?.classList.add('animate');
        }, 400);
        
        setTimeout(() => {
          document.querySelector('.hero-subtitle')?.classList.add('animate');
        }, 600);
        
        setTimeout(() => {
          document.querySelector('.hero-meta')?.classList.add('animate');
        }, 800);
      };

      // Removed parallax effect to prevent background showing

      // Intersection Observer for scroll animations
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            
            // Handle staggered animations for list items
            if (entry.target.classList.contains('info-card')) {
              const listItems = entry.target.querySelectorAll('.use-case-item');
              listItems.forEach((item, index) => {
                setTimeout(() => {
                  item.classList.add('animate');
                }, 400 + (index * 150));
              });
            }
          }
        });
      }, observerOptions);

      // Initialize hero animations first
      heroTimeline();
      
      // Delay observation of description elements until hero animations complete
      setTimeout(() => {
        // Observe only description section elements
        document.querySelectorAll('.description-section .fade-up').forEach(el => {
          observer.observe(el);
        });
      }, 1200); // Wait for hero animations to complete
      
      // Observe features and other elements immediately
      document.querySelectorAll('.features-section .fade-up, .fade-scale').forEach(el => {
        observer.observe(el);
      });
    };

    // Wait for loading screen to complete
    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style>
  /* Hero Animations */
  .hero-image {
    opacity: 0;
    filter: blur(15px) brightness(1);
    will-change: filter, opacity;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transform: translateZ(0);
  }
  
  .hero-image.animate {
    animation: heroImageReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  
  @keyframes heroImageReveal {
    0% {
      opacity: 0;
      filter: blur(15px) brightness(1);
    }
    100% {
      opacity: 1;
      filter: blur(0px) brightness(1);
    }
  }
  
  /* Gradient overlay animation */
  .hero-gradient {
    opacity: 0;
  }
  
  .hero-gradient.animate {
    animation: gradientFadeIn 1.4s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: 0.3s;
  }
  
  @keyframes gradientFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  .hero-badges {
    opacity: 0;
    transform: translateX(-50px);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .hero-badges.animate {
    opacity: 1;
    transform: translateX(0);
  }
  
  .hero-title {
    opacity: 0;
    transform: translateX(-100px) skewX(-5deg);
    transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  
  .hero-title.animate {
    opacity: 1;
    transform: translateX(0) skewX(0);
  }
  
  .hero-subtitle {
    opacity: 0;
    transform: translateX(100px);
    transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1);
  }
  
  .hero-subtitle.animate {
    opacity: 1;
    transform: translateX(0);
  }
  
  .hero-meta {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .hero-meta.animate {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  
  /* Badge stagger animation - Changed to flip in */
  .hero-badges.animate .badge {
    animation: badgeFlip 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    animation-delay: calc(var(--badge-index, 0) * 0.15s);
  }
  
  @keyframes badgeFlip {
    from {
      opacity: 0;
      transform: perspective(400px) rotateY(-90deg);
    }
    to {
      opacity: 1;
      transform: perspective(400px) rotateY(0);
    }
  }
  
  /* Fade up animation - Changed to slide and rotate */
  .fade-up {
    opacity: 0;
    transform: translateY(60px) rotateX(-10deg);
    transform-origin: top center;
    transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }
  
  .fade-up.in-view {
    opacity: 1;
    transform: translateY(0) rotateX(0);
  }
  
  /* Fade scale animation for cards */
  .fade-scale {
    opacity: 0;
    transform: scale(0.95) translateY(20px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transition-delay: calc(0.8s + (var(--card-index, 0) * 0.15s));
  }
  
  .fade-scale.in-view {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  
  /* Use case items animation */
  .use-case-item {
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.5s ease-out;
  }
  
  .use-case-item.animate {
    opacity: 1;
    transform: translateX(0);
  }
  
  /* Info card hover effect */
  .info-card {
    transition: transform 0.3s ease;
  }
  
  .info-card:hover {
    transform: translateY(-5px);
  }
  
  /* Features title animation */
  .features-title {
    position: relative;
    overflow: hidden;
  }
  
  .features-title::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: black;
    transition: width 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  
  .features-title.in-view::after {
    width: 100px;
  }
  
  /* Feature card enhancements */
  .feature-card {
    transition: all 0.3s ease;
    display: flex;
  }
  
  .feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* Make cards responsive to content */
  .features-grid {
    grid-auto-rows: minmax(16rem, auto);
  }

  .card-front {
    min-height: 100%;
  }

  .card-back {
    position: relative;
    height: auto;
  }

  /* Adjust padding and font sizes for better fit */
  .card-back-content h5 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
  }
  
  .card-back-content p {
    font-size: 0.9rem;
    line-height: 1.5;
  }
  
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .feature-card {
      min-height: 14rem;
    }
    
    .card-front {
      padding: 1.5rem;
    }
    
    .card-back {
      padding: 1.5rem;
    }
    
    .card-back-content h5 {
      font-size: 1rem;
    }
    
    .card-back-content p {
      font-size: 0.875rem;
    }
  }
  
  /* Touch device animations */
  .feature-card.is-flipped .card-front {
    transform: translateX(-100%);
  }
  
  .feature-card.is-flipped .card-back-content {
    opacity: 1;
  }
  
  /* Section transitions - Different effects for each section */
  .hero-section {
    animation: heroSectionReveal 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  @keyframes heroSectionReveal {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  
  .description-section {
    animation: descriptionSlide 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  @keyframes descriptionSlide {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  
  .features-section {
    animation: featuresReveal 1s cubic-bezier(0.19, 1, 0.22, 1);
  }
  
  @keyframes featuresReveal {
    from {
      opacity: 0;
      clip-path: polygon(0 0, 100% 0, 100% 0, 0 0);
    }
    to {
      opacity: 1;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }
  }
  
  section:not(.hero-section):not(.description-section):not(.features-section) {
    animation: sectionFadeUp 0.8s ease-out;
  }
  
  @keyframes sectionFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* CTA button hover effects */
  a[href*="projects"],
  a[href*="contact"] {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  
  a[href*="projects"]::before,
  a[href*="contact"]::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
    transition: left 0.3s ease;
    z-index: -1;
  }
  
  a[href*="projects"]:hover::before,
  a[href*="contact"]:hover::before {
    left: 0;
  }
</style>