---
import Layout from '../../../layouts/Layout.astro';
import { getProduct, getProductIds, getAllProducts } from '../../../data/products-multilingual';
import LoadingScreen from '../../../components/LoadingScreen.astro';
import { getCasesByProduct } from '../../../data/cases-multilingual';
import { LucideIcon } from '../../../components/LucideIcon';
import { FloatingCTA } from '../../../components/FloatingCTA';

export const prerender = true;

export async function getStaticPaths() {
  const productIds = getProductIds();
  const languages = ['en', 'es'];

  return languages.flatMap(lang =>
    productIds.map(id => ({
      params: { lang, id }
    }))
  );
}

const { id = '', lang = 'en' } = Astro.params;
const product = getProduct(id, lang);

if (!product) {
  return Astro.redirect(`/${lang}/404`);
}

const relatedCases = getCasesByProduct(id, lang);
const otherProducts = getAllProducts(lang).filter(p => p.id !== id).slice(0, 3);

const translations = await import(`../../../../public/locales/${lang}.json`);
const t = (key: string) => translations.default[key] || key;

// Split description into lead sentence and rest
const descMatch = product.description.match(/^(.+?[.!?])\s+(.*)/s);
const leadSentence = descMatch ? descMatch[1] : product.description;
const restDescription = descMatch ? descMatch[2] : '';

// SEO Data
const seoTitle = `${product.title} - ${product.tagline} | OSIX Tech`;
const seoDescription = product.description.substring(0, 160);

// Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://osix.tech/${lang}/` },
    { "@type": "ListItem", "position": 2, "name": lang === 'es' ? 'Productos' : 'Products', "item": `https://osix.tech/${lang}/#products` },
    { "@type": "ListItem", "position": 3, "name": product.title, "item": `https://osix.tech/${lang}/productos/${id}` }
  ]
};

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": product.description,
  "image": product.images.map(img => `https://osix.tech${img}`),
  "brand": { "@type": "Organization", "name": "OSIX Tech" }
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": seoTitle,
  "description": seoDescription,
  "url": `https://osix.tech/${lang}/productos/${id}`,
  "inLanguage": lang,
  "isPartOf": { "@type": "WebSite", "name": "OSIX Tech", "url": "https://osix.tech" },
  "breadcrumb": breadcrumbSchema
};

const jsonLd = [productSchema, webPageSchema];

// Feature title bullets for sidebar
const featureTitles = product.features.map(f => f.title);
---

<Layout
  lang={lang}
  title={seoTitle}
  description={seoDescription}
  image={product.images[0]}
  pageType="product"
  jsonLd={jsonLd}>
  <LoadingScreen duration={1000} />

  <!-- HERO — Full-bleed image -->
  <section class="hero-section relative min-h-[500px] bg-black lg:min-h-[600px] flex items-center overflow-hidden mb-0" style="margin-top: var(--header-h, 0px)">
    <div class="hero-bg absolute inset-0 z-0 bg-black">
      <img src={product.images[0]} alt={product.title} class="hero-image object-cover w-full h-full" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    </div>
    <div class="relative z-10 px-4 sm:px-6 lg:px-10 w-full pt-20">
      <div class="max-w-2xl">
        <span class={`hero-badges inline-block px-3 py-1 backdrop-blur-sm text-sm border mb-6 opacity-0 ${product.textColor === 'dark' ? 'bg-black/20 text-black border-black/30' : 'bg-white/20 text-white border-white/30'}`}>
          {lang === 'es' ? 'Producto' : 'Product'}
        </span>
        <h1 class={`hero-title text-5xl md:text-7xl font-bold mb-3 md:mb-6 opacity-0 ${product.textColor === 'dark' ? 'text-black' : 'text-white'}`}>{product.title}</h1>
        <h5 class={`hero-subtitle text-xl md:text-2xl mb-8 opacity-0 ${product.textColor === 'dark' ? 'text-gray-800' : 'text-gray-50'}`}>{product.tagline}</h5>
        <a href={`/${lang}/#contact`} class={`hero-cta inline-flex items-center px-8 py-3 font-semibold text-base transition-all duration-300 opacity-0 ${product.textColor === 'dark' ? 'bg-black text-white hover:bg-gray-800' : 'bg-white text-black hover:bg-gray-100'}`}>
          {t('products.requestDemo')}
        </a>
      </div>
    </div>
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 opacity-0 scroll-indicator">
      <span class={`text-xs tracking-widest uppercase ${product.textColor === 'dark' ? 'text-gray-600' : 'text-gray-400'}`}>{t('products.scrollDown')}</span>
      <svg class={`w-5 h-5 animate-bounce ${product.textColor === 'dark' ? 'text-gray-600' : 'text-gray-400'}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- OVERVIEW — 60/40 Split -->
  <section class="py-16 bg-white mb-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Left: Description (60%) -->
        <div class="lg:w-3/5 fade-up" style="--delay: 0.1s">
          <p class="text-2xl md:text-3xl text-gray-900 font-light leading-relaxed mb-6">{leadSentence}</p>
          {restDescription && (
            <p class="text-base text-gray-600 leading-relaxed">{restDescription}</p>
          )}
        </div>
        <!-- Right: Sidebar card (40%) -->
        <div class="lg:w-2/5 fade-up" style="--delay: 0.2s">
          <div class="bg-gray-50 border border-gray-200 p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-black flex items-center justify-center">
                <LucideIcon name={product.icon} className="text-white" size={20} client:load />
              </div>
              <div>
                <h3 class="font-bold text-black">{product.title}</h3>
                <p class="text-xs text-gray-500">{product.tagline}</p>
              </div>
            </div>
            <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">{t('products.overview.keyFacts')}</h4>
            <ul class="space-y-2 mb-6">
              {featureTitles.map(title => (
                <li class="flex items-center gap-2 text-sm text-gray-700">
                  <svg class="w-4 h-4 text-black flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {title}
                </li>
              ))}
            </ul>
            <a href={`/${lang}/#contact`} class="block w-full text-center bg-black text-white py-3 text-sm font-semibold hover:bg-gray-800 transition-colors">
              {t('products.requestDemo')}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES — Zigzag layout -->
  <section class="py-16 bg-gray-50 mb-0">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-black mb-12 fade-up" style="--delay: 0.1s">
        {t('products.features')}
      </h2>
      <div class="space-y-12">
        {product.features.map((feature, index) => (
          <div class={`flex flex-col md:flex-row items-start gap-8 fade-up ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''}`} style={`--delay: ${0.15 + index * 0.1}s`}>
            <div class="flex-shrink-0 w-16 h-16 bg-black flex items-center justify-center">
              <LucideIcon name={feature.icon} className="text-white" size={32} client:load />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-black mb-2">{feature.title}</h3>
              <p class="text-gray-600 leading-relaxed">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  {product.video && (
    <section class="py-16 mb-0">
      <div class="mx-auto px-4 sm:px-6 lg:px-10">
        <h2 class="text-3xl font-bold text-black text-left mb-12">{product.title} {lang === 'es' ? 'en acción' : 'in action'}</h2>
        <div class="relative aspect-[16/9] content-fit overflow-hidden bg-black shadow-lg">
          <video
            autoplay
            muted
            loop
            playsinline
            class="w-full h-full object-cover"
            poster={product.images[0]}
            preload="metadata"
            onloadedmetadata="this.playbackRate = 2.0;"
          >
            <source src={product.video} type="video/mp4" />
            {lang === 'es' ? 'Tu navegador no soporta la reproducción de video.' : 'Your browser does not support video playback.'}
          </video>
        </div>
      </div>
    </section>
  )}

  <!-- SOCIAL PROOF — Featured case testimonial -->
  {relatedCases.length > 0 && (
    <section class="py-16 bg-white mb-0">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href={`/${lang}/impacto/${relatedCases[0].id}`} class="group block bg-black p-8 md:p-12 fade-up" style="--delay: 0.1s">
          <span class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-4 block">{t('products.caseStudy')}</span>
          <p class="text-xl md:text-2xl text-white font-light leading-relaxed mb-6">"{relatedCases[0].summary}"</p>
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="text-white font-semibold">{relatedCases[0].client}</p>
              <p class="text-gray-400 text-sm">{relatedCases[0].title}</p>
            </div>
            <span class="inline-flex items-center text-sm font-semibold text-white group-hover:translate-x-1 transition-transform duration-200">
              {t('caseStudies.viewMore')} →
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- BOTTOM CTA — Cross-sell + contact -->
  <section class="bottom-cta-section py-16 bg-black mb-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-10">
      <div class="flex flex-col lg:flex-row gap-12">
        <!-- Left: Explore more products -->
        {otherProducts.length > 0 && (
          <div class="lg:w-1/2">
            <h3 class="text-sm font-bold uppercase tracking-widest text-gray-500 mb-6">{t('products.cta.explore')}</h3>
            <div class="space-y-3">
              {otherProducts.map(p => (
                <a href={`/${lang}/productos/${p.id}`} class="group flex items-center gap-4 p-4 border border-white/10 hover:border-white/30 transition-colors">
                  <div class="w-10 h-10 bg-white/10 flex items-center justify-center flex-shrink-0">
                    <LucideIcon name={p.icon} className="text-white" size={18} client:load />
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-white font-semibold text-sm group-hover:underline">{p.title}</p>
                    <p class="text-gray-400 text-xs truncate">{p.tagline}</p>
                  </div>
                  <svg class="w-4 h-4 text-gray-500 group-hover:text-white group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        )}
        <!-- Right: Contact CTA -->
        <div class={`${otherProducts.length > 0 ? 'lg:w-1/2' : 'w-full'} flex flex-col items-center justify-center text-center`}>
          <h2 class="text-3xl font-bold text-white mb-4">{t('products.cta.title')}</h2>
          <p class="text-gray-400 mb-8">{t('products.cta.subtitle')}</p>
          <a href={`/${lang}/#contact`} class="inline-flex items-center bg-white text-black px-10 py-4 text-lg font-semibold hover:bg-gray-100 transition-colors">
            {t('products.cta.getStarted')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating CTA Bar -->
  <FloatingCTA
    productName={product.title}
    demoLabel={t('products.requestDemo')}
    contactLabel={t('nav.contact')}
    contactHref={`/${lang}/#contact`}
    client:load
  />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initializeAnimations = () => {
      const heroTimeline = () => {
        document.querySelector('.hero-image')?.classList.add('animate');
        setTimeout(() => { document.querySelector('.hero-badges')?.classList.add('animate'); }, 200);
        setTimeout(() => { document.querySelector('.hero-title')?.classList.add('animate'); }, 400);
        setTimeout(() => { document.querySelector('.hero-subtitle')?.classList.add('animate'); }, 600);
        setTimeout(() => { document.querySelector('.hero-cta')?.classList.add('animate'); }, 800);
        setTimeout(() => { document.querySelector('.scroll-indicator')?.classList.add('animate'); }, 1200);
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('in-view');
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      heroTimeline();

      setTimeout(() => {
        document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
      }, 1200);
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>

<style>
  .hero-image {
    opacity: 0;
    filter: blur(15px) brightness(1);
    will-change: filter, opacity;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  .hero-image.animate {
    animation: heroImageReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes heroImageReveal {
    0% { opacity: 0; filter: blur(15px) brightness(1); }
    100% { opacity: 1; filter: blur(0px) brightness(1); }
  }
  .hero-badges {
    opacity: 0;
    transform: translateX(-50px);
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .hero-badges.animate { opacity: 1; transform: translateX(0); }
  .hero-title {
    opacity: 0;
    transform: translateX(-100px) skewX(-5deg);
    transition: all 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .hero-title.animate { opacity: 1; transform: translateX(0) skewX(0); }
  .hero-subtitle {
    opacity: 0;
    transform: translateX(100px);
    transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .hero-subtitle.animate { opacity: 1; transform: translateX(0); }
  .hero-cta {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .hero-cta.animate { opacity: 1; transform: translateY(0); }
  .scroll-indicator {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .scroll-indicator.animate { opacity: 1; }
  .fade-up {
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0s);
  }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }
  .hero-section { animation: heroSectionReveal 1s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes heroSectionReveal {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
