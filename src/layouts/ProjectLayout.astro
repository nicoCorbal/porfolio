---
import Layout from './Layout.astro';

export interface ProjectData {
  id: string;
  title: string;
  subtitle: string;
  category: string;
  type: string;
  date: string;
  awards?: string[];
  birth: string;
  usecase: string[];
  future: string;
  features: Array<{
    title: string;
    description: string;
    icon?: string;
  }>;
  images: string[];
  video?: string;
  liveUrl?: string;
  githubUrl?: string;
}

export interface Props {
  project: ProjectData;
}

const { project } = Astro.props;

const title = `${project.title} – Proyecto`;
const description = project.subtitle;
const image = project.images[0];
// Extract lang from URL - handle both /proyecto/id and /lang/proyecto/id patterns
const pathSegments = Astro.url.pathname.split('/').filter(segment => segment);
const lang = ['es', 'en'].includes(pathSegments[0]) ? pathSegments[0] : 'es';
---

<Layout {title} {description} {image} {lang}>
  <!-- HERO -->
  <section class="relative min-h-[450px] lg:min-h-[550px] flex items-center overflow-hidden pt-20">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img src={project.images[0]} alt={project.title} class="object-cover object-top w-full h-full" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
    </div>
    
    <!-- Content -->
    <div class="relative z-10 mx-auto px-4 sm:px-6 lg:px-10 w-full">
      <div class="max-w-2xl">
        <div class="flex items-center flex-wrap gap-4 mb-6">
          <span class="px-3 py-1 rounded-[4px] bg-white/20 backdrop-blur-sm text-white text-sm border border-white/30">{project.category}</span>
          {project.awards && project.awards.map((award) => (
            <span class="px-3 py-1 rounded-[4px] bg-yellow-400/20 backdrop-blur-sm border border-yellow-400/50 text-yellow-100 text-sm">🏆 {award}</span>
          ))}
        </div>

        <h1 class="text-5xl lg:text-7xl font-bold text-white mb-6">{project.title}</h1>
        <p class="text-xl lg:text-2xl text-gray-50 mb-8">{project.subtitle}</p>

        <div class="flex flex-row gap-8 mb-8 text-left">
          <div>
            <p class="text-sm text-gray-400 mb-1">Tipo</p>
            <p class="font-medium text-gray-50">{project.type}</p>
          </div>
          <div>
            <p class="text-sm text-gray-400 mb-1">Fecha</p>
            <p class="font-medium text-gray-50">{project.date}</p>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-base border-2 border-white hover:bg-white hover:text-black text-white px-6 py-3 rounded-[8px] font-medium transition-all duration-200">
              Contactar
            </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DESCRIPCIÓN -->
  <section class="py-16 bg-white mb-0">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-16">
        
        <!-- CÓMO NACIÓ -->
        <div>
          <h2 class="text-3xl font-bold text-black mb-4">Cómo nació {project.title}</h2>
          <p class="text-gray-900 leading-relaxed text-justify">{project.birth}</p>
        </div>
    
        <!-- CASOS DE USO -->
        <div>
          <h2 class="text-3xl font-bold text-black mb-4">Casos de uso de {project.title}</h2>
          <ul class="space-y-4">
            {project.usecase.map((item) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-black mt-1 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-800 leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>
    
        <!-- FUTURO -->
        <div>
          <h2 class="text-3xl font-bold text-black mb-4">El Futuro de {project.title}</h2>
          <p class="text-gray-900 leading-relaxed text-justify">{project.future}</p>
        </div>
    
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="bg-white py-16 mb-0">
    <div class="w-full mx-auto px-4 sm:px-6 lg:px-10">
      <h2 class="text-3xl font-bold text-black text-left  mb-12">Características Principales</h2>
      <div class={`grid gap-8 ${
        project.features.length <= 2 ? 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto' :
        project.features.length <= 4 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-2' :
        project.features.length <= 6 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3' :
        project.features.length <= 8 ? 'grid-cols-1 md:grid-cols-2 lg:grid-cols-4' :
        'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
      }`}>
        {project.features.map((feature) => (
          <div class="group relative h-64 w-full overflow-hidden rounded-lg border border-gray-200 shadow-lg">
            
            {/* CARD BACK (Hidden Content) */}
            <div class="absolute inset-0 z-10 rounded-lg bg-black bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.04)_0%,transparent_40%)] p-6 text-left text-white">
              <div class="opacity-0 transition-all duration-[400ms] delay-200 group-hover:opacity-100">
                <h5 class="mb-4 w-full border-b border-gray-600 pb-4 text-lg font-semibold">
                  {feature.title}
                </h5>
                <p class="text-sm leading-relaxed text-gray-50 opacity-90">
                  {feature.description}
                </p>
              </div>
            </div>

            {/* CARD FRONT (Sliding Panel) */}
            <div class="absolute inset-0 z-20 flex flex-col items-center justify-center gap-4 rounded-lg bg-gradient-to-br from-white to-gray-50 p-6 shadow-[inset_0_0_0_1px_#e5e7eb] transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:-translate-x-full">
              
              {/* Icon Wrapper */}
              <div class="flex h-20 w-20 items-center justify-center rounded-lg bg-black shadow-md transition-transform duration-300 group-hover:scale-110">
                {feature.icon ? (
                  <div class="w-10 h-10 text-white" set:html={feature.icon}></div>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.539 1.118l-3.975-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.539-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.783-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                )}
              </div>
              <h4 class="text-xl font-semibold text-black text-center">{feature.title}</h4>
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO DEMO -->
  {project.video && (
    <section class="py-16 mb-0">
      <div class="mx-auto px-4 sm:px-6 lg:px-10">
        <h2 class="text-3xl font-bold text-black text-left  mb-12">{project.title} en acción</h2>
         <div class="relative aspect-[16/9] content-fit overflow-hidden bg-black  rounded-lg shadow-lg">
          <video
            autoplay
            muted
            loop
            playsinline
            controls
            class="w-full h-full object-cover"
            poster={project.images[1] || project.images[0]}
            preload="metadata"
          >
            <source src={project.video} type="video/mp4" />
            Tu navegador no soporta la reproducción de video.
          </video>
        </div>
      </div>
    </section>
  )}


  <!-- CTA -->
  <section class="py-16 bg-black">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-10 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">¿Te interesa este proyecto?</h2>
      <p class="text-lg text-gray-50 mb-8">No dudes en contactarnos para obtener más información</p>
      <div class="flex justify-center gap-4 flex-wrap">
        <a href={`/${lang}/contacto`} class="inline-flex text-black  items-center bg-white hover:bg-gray-100 px-6 py-3 rounded-lg text-base">
          Ver Más Proyectos
        </a>
        <a href={`/${lang}/proyectos`} class="inline-flex items-center border border-gray-300 hover:bg-gray-800 text-white px-6 py-3 rounded-lg text-base">
          Contactar
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Additional styling for feature cards can go here if needed */
</style>

