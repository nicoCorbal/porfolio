---
import { getAllServices } from '../data/services-multilingual';
import FlowingMenu from './FlowingMenu.jsx';

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const services = getAllServices(lang);
const defaultImage = '/og-image.png';
const menuItems = services.map(service => ({
  link: `/${lang}/servicios/${service.id}`,
  text: service.title,
  subtitle: service.tagline,
  image: service.image || defaultImage,
}));
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={t('services.section.title')} />

    <div class="flowing-menu-container">
      <FlowingMenu
        items={menuItems}
        client:visible
      />
    </div>
  </div>
</section>

<style is:global>
  .flowing-menu-container {
    height: 500px;
  }

  .flowing-menu-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .flowing-menu {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .flowing-menu__item {
    flex: 1;
    position: relative;
    overflow: hidden;
    text-align: left;
    border-top: 1px solid #e5e7eb;
  }

  .flowing-menu__item:last-child {
    border-bottom: 1px solid #e5e7eb;
  }

  .flowing-menu__item-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2rem;
    height: 100%;
    position: relative;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .flowing-menu__title {
    font-weight: 400;
    font-size: 4vh;
  }

  .flowing-menu__subtitle {
    font-weight: 300;
    font-size: 1.8vh;
    color: rgba(0, 0, 0, 0.4);
    text-align: right;
    max-width: 40%;
    white-space: normal;
    line-height: 1.4;
  }

  .flowing-menu__item:nth-child(even) .flowing-menu__subtitle {
    text-align: left;
  }

  .flowing-menu__item-link:hover {
    color: inherit;
  }

  .flowing-marquee {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transform: translate3d(0, 101%, 0);
  }

  .flowing-marquee__inner-wrap {
    height: 100%;
    width: 100%;
    overflow: hidden;
  }

  .flowing-marquee__inner {
    display: flex;
    align-items: center;
    position: relative;
    height: 100%;
    width: fit-content;
    will-change: transform;
  }

  .flowing-marquee__part {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .flowing-marquee span {
    white-space: nowrap;
    font-weight: 400;
    font-size: 4vh;
    line-height: 1;
    padding: 0 1vw;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .flowing-marquee__img {
    width: 200px;
    height: 7vh;
    margin: 2em 2vw;
    padding: 1em 0;
    border-radius: 50px;
    background-size: cover;
    background-position: 50% 50%;
  }

  @media (max-width: 768px) {
    .flowing-menu-container {
      height: 400px;
    }

    .flowing-menu__title {
      font-size: 3vh;
    }

    .flowing-menu__subtitle {
      display: none;
    }

    .flowing-marquee span {
      font-size: 3vh;
    }
  }
</style>
