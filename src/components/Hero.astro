---
interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;
---

<section id="home" class="relative w-full min-h-screen flex flex-col items-center justify-start pt-20 overflow-hidden">
  <div class="absolute top-18 md:top-20 left-1/2 transform -translate-x-1/2 !text-black text-center z-10 hero-title">
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-medium whitespace-nowrap">{t('hero.title.line1')}</h1>
    <h1 class="text-2xl sm:text-3xl md:text-4xl font-medium mt-1 md:mt-2 whitespace-nowrap">{t('hero.title.line2')}</h1>
  </div>
  <!-- Background video -->
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/hero.jpg" 
    class="absolute inset-0 w-full h-full object-cover z-0 hero-video"
    x-webkit-airplay="allow"
    webkit-playsinline="true"
    playsinline="true"
  >
    <source src="/hero_video_60fps.webm" type="video/webm" />
    <source src="/hero_video_60fps.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>

  <!-- CTA Buttons -->
  <div id="hero-cta-container" class="absolute bottom-40 md:bottom-36 left-1/2 transform -translate-x-1/2 z-10 flex flex-col sm:flex-row gap-4 items-center hero-cta">
    <a href="#projects" class="hero-cta-button bg-black text-white border-2 border-black hover:bg-white hover:text-black">
      {t('hero.cta.projects')}
    </a>
    <a href="#contact" class="hero-cta-button bg-white text-black border-2 border-black hover:bg-black hover:text-white">
      {t('hero.cta.contact')}
    </a>
  </div>

  <!-- Center headline & logo -->
  <div id="hero-logo-container" class="absolute bottom-20 md:bottom-16 left-1/2 z-10 hero-logo">
    <img
      src="/full_logo.png"
      alt="OSIX"
      class="w-28 sm:w-32 md:w-40 lg:w-44 h-auto"
    />
  </div>
  <div class="absolute bottom-0 left-0 w-full pointer-events-none z-10"></div>
</section>

<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  /* Initial states - hide elements before animation */
  .hero-title, .hero-cta {
    opacity: 0;
    transform: translateY(20px) translateX(-50%);
  }
  
  .hero-logo {
    opacity: 0;
  }
  
  #hero-logo-container {
    transform: translateX(-50%) translateY(20px);
  }
  
  .hero-video {
    transform: scale(0.3);
    opacity: 0;
  }

  /* Animation classes - only applied after loading completes */
  body.loading-complete .hero-title {
    animation: fadeIn 1s ease-out 0.2s forwards;
  }

  body.loading-complete .hero-logo {
    animation: fadeInLogo 1s ease-out 0.5s forwards;
  }
  
  body.loading-complete #hero-logo-container {
    animation: slideUpLogo 1s ease-out 0.5s forwards;
  }

  body.loading-complete .hero-cta {
    animation: fadeIn 1s ease-out 0.8s forwards;
  }

  body.loading-complete .hero-video {
    animation: expandIn 1.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  @keyframes fadeIn {
    from { 
      opacity: 0; 
      transform: translateY(20px) translateX(-50%); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0) translateX(-50%); 
    }
  }
  
  @keyframes fadeInLogo {
    from { 
      opacity: 0; 
    }
    to { 
      opacity: 1; 
    }
  }
  
  @keyframes slideUpLogo {
    from { 
      transform: translateX(-50%) translateY(20px); 
    }
    to { 
      transform: translateX(-50%) translateY(0); 
    }
  }

  @keyframes expandIn {
    from { 
      transform: scale(0.3);
      opacity: 0;
    }
    to { 
      transform: scale(1);
      opacity: 1;
    }
  }

  .hero-cta-button {
    @apply px-6 py-3 font-semibold text-lg text-center transition-all duration-300 w-full sm:w-auto;
    min-width: 160px;
  }

</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    
    const video = document.querySelector('video');
    if (video) {
      // Force play on iOS
      video.play().catch(function(error) {
        console.log("Video autoplay failed:", error);
      });
    }

    const scrollLink = document.querySelector<HTMLAnchorElement>('.scroll-down-link');
    if (scrollLink) {
      scrollLink.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        if (!targetId) return;
        const targetElement = document.querySelector(targetId) as HTMLElement;
        if (targetElement) {
          const header = document.getElementById('main-header');
          const headerHeight = header ? header.offsetHeight : 0;
          const targetPosition = targetElement.getBoundingClientRect().top + window.pageYOffset - headerHeight;
          smoothScrollTo(targetPosition, 2000); // 2000ms duration for a slower scroll
        }
      });
    }

    function smoothScrollTo(targetPosition: number, duration: number) {
      const startPosition = window.pageYOffset;
      const distance = targetPosition - startPosition;
      let startTime: number | null = null;
      
      function animation(currentTime: number) {
        if (startTime === null) startTime = currentTime;
        const timeElapsed = currentTime - startTime;
        const progress = Math.min(timeElapsed / duration, 1);
        const ease = easeInOutCubic(progress);
        
        window.scrollTo(0, startPosition + distance * ease);
        
        if (timeElapsed < duration) {
          requestAnimationFrame(animation);
        }
      }
      
      function easeInOutCubic(t: number) {
        return t < 0.5 
          ? 4 * t * t * t 
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }
      
      requestAnimationFrame(animation);
    }
  });
</script>