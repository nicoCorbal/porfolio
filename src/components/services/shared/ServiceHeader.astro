---

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
---

<header class="fixed top-0 left-0 w-full bg-white z-50 border-b-2 border-black shadow-md">
  <div class="flex items-center justify-between px-6 md:px-12 py-4 md:py-6 max-w-full">
    <!-- Logo -->
    <a href={`/${lang}`} class="flex-shrink-0">
      <img src="/full_logo.png" alt="OSIX Tech logo" class="w-[120px] md:w-[160px]">
    </a>

    <!-- Center spacer -->
    <div class="flex-1"></div>

    <!-- Right side: Language + Contact -->
    <div class="flex items-center gap-4 md:gap-6">
      <!-- Language switcher -->
      <div class="flex items-center gap-2">
        <a
          href={`/es${Astro.url.pathname.replace(/^\/(en|es)/, '')}`}
          class={`px-2 py-1 text-sm font-semibold transition ${lang === 'es' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'}`}
        >
          ES
        </a>
        <span class="text-gray-300">|</span>
        <a
          href={`/en${Astro.url.pathname.replace(/^\/(en|es)/, '')}`}
          class={`px-2 py-1 text-sm font-semibold transition ${lang === 'en' ? 'text-black border-b-2 border-black' : 'text-gray-500 hover:text-black'}`}
        >
          EN
        </a>
      </div>

      <!-- Contact button -->
      <a
        href="#contact"
        class="hidden md:block bg-black text-white px-6 py-3 font-medium text-sm hover:bg-gray-800 transition"
      >
        {lang === 'es' ? 'Contactar' : 'Contact'}
      </a>
    </div>
  </div>
</header>

<style>
  header {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
