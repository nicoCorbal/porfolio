---
interface PainPoint {
  iconName: string;      // Icon name or simple emoji
  titleKey: string;      // i18n key
  descKey: string;       // i18n key
}

interface Props {
  painPoints: PainPoint[];
  lang: 'en' | 'es';
}

const { painPoints, lang } = Astro.props;

// Import locale files
const locales = {
  en: (await import('/public/locales/en.json')).default,
  es: (await import('/public/locales/es.json')).default,
};

const t = locales[lang];

// Helper to get nested translation keys
const getTranslation = (key: string): string => {
  const keys = key.split('.');
  let value: any = t;
  for (const k of keys) {
    value = value?.[k];
  }
  return value || key;
};

// Simple icon mapping
const iconMap: Record<string, string> = {
  'search': '🔍',
  'clock': '⏱️',
  'document': '📄',
  'warning': '⚠️',
  'users': '👥',
  'chart': '📊',
};
---

<section class="w-full bg-white py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <!-- Section title -->
    <h2 class="text-3xl md:text-4xl font-bold text-black mb-4">
      {lang === 'es' ? '¿Te suena familiar?' : 'Sound familiar?'}
    </h2>
    <p class="text-gray-700 mb-12 md:mb-16">
      {lang === 'es'
        ? 'Reconoce los problemas que enfrentan las empresas como la tuya'
        : 'Recognize the problems that companies like yours face'}
    </p>

    <!-- Pain points grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {painPoints.map((point, index) => (
        <div
          key={index}
          class="border-2 border-black p-6 md:p-8 bg-white hover:shadow-xl transition-shadow duration-200 group"
        >
          <!-- Icon -->
          <div class="text-4xl md:text-5xl mb-4 group-hover:scale-110 transition-transform duration-200">
            {iconMap[point.iconName] || point.iconName}
          </div>

          <!-- Title -->
          <h3 class="text-xl md:text-2xl font-bold text-black mb-3">
            {getTranslation(point.titleKey)}
          </h3>

          <!-- Description -->
          <p class="text-gray-700 text-base md:text-lg">
            {getTranslation(point.descKey)}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
