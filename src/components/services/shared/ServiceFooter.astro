---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;



---

<footer class="w-full bg-black text-white py-12 md:py-16 border-t-2 border-gray-800">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <!-- Top section: Logo + Info -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12 pb-12 border-b border-gray-700">
      <!-- Logo -->
      <div>
        <img src="/full_logo.png" alt="OSIX Tech" class="w-[140px] md:w-[180px] brightness-0 invert mb-4">
        <p class="text-sm text-gray-400">
          {lang === 'es'
            ? 'Soluciones de IA y desarrollo a medida para empresas gallegas.'
            : 'AI solutions and custom development for Galician companies.'}
        </p>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="font-semibold mb-4">{lang === 'es' ? 'Contacto' : 'Contact'}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="mailto:hola@osix.tech" class="text-gray-400 hover:text-white transition">
              hola@osix.tech
            </a>
          </li>
          <li>
            <a href="tel:+34881823123" class="text-gray-400 hover:text-white transition">
              +34 881 823 123
            </a>
          </li>
          <li class="text-gray-400">
            Santiago de Compostela, Galicia
          </li>
        </ul>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold mb-4">{lang === 'es' ? 'Enlaces' : 'Links'}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`/${lang}/privacy`} class="text-gray-400 hover:text-white transition">
              {lang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
            </a>
          </li>
          <li>
            <a href={`/${lang}`} class="text-gray-400 hover:text-white transition">
              {lang === 'es' ? 'Inicio' : 'Home'}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom section -->
    <div class="flex flex-col md:flex-row items-center justify-between text-sm text-gray-400">
      <p>© 2025 OSIX Tech. {lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}</p>

      <!-- IGAPE / EU Logos (optional) -->
      <div class="mt-6 md:mt-0 flex items-center gap-4">
        <p class="text-xs text-gray-500">
          {lang === 'es'
            ? 'Con apoyo de IGAPE y fondos europeos'
            : 'Supported by IGAPE and European funds'}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
