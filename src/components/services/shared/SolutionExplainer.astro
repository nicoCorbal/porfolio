---
interface Solution {
  titleKey: string;
  stepsKeys: string[];
  benefitsKeys: string[];
}

interface Props {
  solution: Solution;
  lang: 'en' | 'es';
}

const { solution, lang } = Astro.props;

// Import locale files
const locales = {
  en: (await import('/public/locales/en.json')).default,
  es: (await import('/public/locales/es.json')).default,
};

const t = locales[lang];

// Helper to get nested translation keys
const getTranslation = (key: string): string => {
  const keys = key.split('.');
  let value: any = t;
  for (const k of keys) {
    value = value?.[k];
  }
  return value || key;
};
---

<section class="w-full bg-white py-16 md:py-24 border-b-2 border-black">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <!-- Title -->
    <h2 class="text-3xl md:text-4xl font-bold text-black mb-12 md:mb-16">
      {getTranslation(solution.titleKey)}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      <!-- Steps -->
      <div class="space-y-8">
        <h3 class="text-xl md:text-2xl font-semibold text-black mb-6">
          {lang === 'es' ? 'Cómo funciona' : 'How it works'}
        </h3>

        <div class="space-y-6">
          {solution.stepsKeys.map((stepKey, index) => (
            <div key={index} class="flex gap-4 md:gap-6">
              <!-- Step number circle -->
              <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 md:w-14 md:h-14 bg-black text-white font-bold text-lg md:text-xl rounded-full">
                {index + 1}
              </div>

              <!-- Step content -->
              <div class="pt-2 md:pt-3">
                <p class="text-base md:text-lg text-gray-700">
                  {getTranslation(stepKey)}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Benefits -->
      <div class="space-y-8">
        <h3 class="text-xl md:text-2xl font-semibold text-black mb-6">
          {lang === 'es' ? 'Beneficios clave' : 'Key benefits'}
        </h3>

        <div class="space-y-4">
          {solution.benefitsKeys.map((benefitKey) => (
            <div key={benefitKey} class="flex gap-4 items-start">
              <!-- Checkmark -->
              <div class="flex-shrink-0 mt-1">
                <svg
                  class="w-6 h-6 md:w-7 md:h-7 text-black"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M5 13l4 4L19 7"
                  ></path>
                </svg>
              </div>

              <!-- Benefit text -->
              <p class="text-base md:text-lg text-gray-700 pt-0.5">
                {getTranslation(benefitKey)}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
