---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
---

<section class="w-full bg-black text-white py-16 md:py-24 border-b-2 border-gray-800">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-12 md:mb-16">
      {lang === 'es' ? 'Resultados de TAKE en números' : 'TAKE results in numbers'}
    </h2>

    <!-- Stats grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 mb-12 md:mb-16">
      <div class="border-2 border-white p-8 md:p-10">
        <div class="text-4xl md:text-5xl font-bold text-white mb-3">+40%</div>
        <p class="text-lg text-gray-300">
          {lang === 'es'
            ? 'Incremento en retención de clientes en 6 meses'
            : 'Increase in customer retention in 6 months'}
        </p>
      </div>

      <div class="border-2 border-white p-8 md:p-10">
        <div class="text-4xl md:text-5xl font-bold text-white mb-3">+25%</div>
        <p class="text-lg text-gray-300">
          {lang === 'es'
            ? 'Aumento en ticket medio por cliente'
            : 'Increase in average ticket per customer'}
        </p>
      </div>

      <div class="border-2 border-white p-8 md:p-10">
        <div class="text-4xl md:text-5xl font-bold text-white mb-3">50K+</div>
        <p class="text-lg text-gray-300">
          {lang === 'es'
            ? 'Transacciones procesadas por mes'
            : 'Transactions processed per month'}
        </p>
      </div>

      <div class="border-2 border-white p-8 md:p-10">
        <div class="text-4xl md:text-5xl font-bold text-white mb-3">98%</div>
        <p class="text-lg text-gray-300">
          {lang === 'es'
            ? 'Disponibilidad del sistema'
            : 'System uptime'}
        </p>
      </div>
    </div>

    <!-- What's included -->
    <div class="bg-gray-900 border-2 border-white p-8 md:p-12">
      <h3 class="text-2xl font-bold text-white mb-6">
        {lang === 'es' ? 'Qué incluye TAKE' : 'What TAKE includes'}
      </h3>

      <ul class="space-y-4">
        {[
          {
            titleEs: 'App móvil personalizada',
            titleEn: 'Customized mobile app',
            descEs: 'iOS y Android con tu marca',
            descEn: 'iOS and Android with your branding',
          },
          {
            titleEs: 'Sistema de puntos',
            titleEn: 'Points system',
            descEs: 'Flexible, personalizable según tu negocio',
            descEn: 'Flexible, customizable for your business',
          },
          {
            titleEs: 'Dashboard de gestión',
            titleEn: 'Management dashboard',
            descEs: 'Controla clientes, ofertas, campañas',
            descEn: 'Control customers, offers, campaigns',
          },
          {
            titleEs: 'Pagos integrados',
            titleEn: 'Integrated payments',
            descEs: 'Stripe, Paypal, transferencias',
            descEn: 'Stripe, Paypal, bank transfers',
          },
          {
            titleEs: 'Notificaciones push',
            titleEn: 'Push notifications',
            descEs: 'Campañas dirigidas a clientes específicos',
            descEn: 'Campaigns targeted to specific customers',
          },
          {
            titleEs: 'Soporte 24/7',
            titleEn: '24/7 Support',
            descEs: 'Equipo técnico disponible siempre',
            descEn: 'Technical team always available',
          },
        ].map((item) => (
          <li class="flex gap-4">
            <span class="text-green-400 text-2xl flex-shrink-0">✓</span>
            <div>
              <p class="font-semibold text-white">
                {lang === 'es' ? item.titleEs : item.titleEn}
              </p>
              <p class="text-gray-400 text-sm">
                {lang === 'es' ? item.descEs : item.descEn}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  section {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
