---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
---

<section class="w-full bg-gray-50 py-16 md:py-24 border-b-2 border-black">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <h2 class="text-3xl md:text-4xl font-bold text-black mb-4 md:mb-6">
      {lang === 'es' ? 'Nuestro proceso' : 'Our process'}
    </h2>
    <p class="text-gray-700 mb-12 md:mb-16">
      {lang === 'es'
        ? 'Entendemos tu negocio, diseñamos la solución exacta, y entregamos un sistema que funciona.'
        : 'We understand your business, design the exact solution, and deliver a system that works.'}
    </p>

    <!-- Timeline -->
    <div class="space-y-8 md:space-y-12">
      {[
        {
          titleEs: 'Descubrimiento',
          titleEn: 'Discovery',
          descEs: 'Entrevistas con tu equipo, análisis de flujos de trabajo, identificación de necesidades.',
          descEn: 'Interviews with your team, workflow analysis, needs identification.',
        },
        {
          titleEs: 'Diseño',
          titleEn: 'Design',
          descEs: 'Propuesta de arquitectura, mockups, diagrama de integraciones.',
          descEn: 'Architecture proposal, mockups, integration diagrams.',
        },
        {
          titleEs: 'Desarrollo',
          titleEn: 'Development',
          descEs: 'Construcción iterativa con feedback. Entregas parciales cada 2 semanas.',
          descEn: 'Iterative construction with feedback. Partial deliveries every 2 weeks.',
        },
        {
          titleEs: 'Integración',
          titleEn: 'Integration',
          descEs: 'Conexión con sistemas existentes (ERP, CRM, bases de datos).',
          descEn: 'Connection with existing systems (ERP, CRM, databases).',
        },
        {
          titleEs: 'Capacitación',
          titleEn: 'Training',
          descEs: 'Tu equipo aprende a usar el sistema. Documentación completa.',
          descEn: 'Your team learns to use the system. Complete documentation.',
        },
        {
          titleEs: 'Soporte',
          titleEn: 'Support',
          descEs: 'Mantenimiento, bug fixes, evolución según tus nuevas necesidades.',
          descEn: 'Maintenance, bug fixes, evolution according to your new needs.',
        },
      ].map((step, index) => (
        <div class="flex gap-6 md:gap-8">
          {/* Timeline circle */}
          <div class="flex flex-col items-center">
            <div class="w-16 h-16 md:w-20 md:h-20 bg-black text-white flex items-center justify-center rounded-full font-bold text-2xl flex-shrink-0">
              {index + 1}
            </div>
            {index < 5 && <div class="w-1 h-12 md:h-16 bg-black mt-4"></div>}
          </div>

          {/* Content */}
          <div class="pb-4 md:pb-8 pt-2 md:pt-4">
            <h3 class="text-2xl font-bold text-black mb-2">
              {lang === 'es' ? step.titleEs : step.titleEn}
            </h3>
            <p class="text-gray-700 text-lg">
              {lang === 'es' ? step.descEs : step.descEn}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    font-family: 'Plus Jakarta Sans', sans-serif;
  }
</style>
