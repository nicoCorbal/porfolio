---
interface Props {
  lang?: string;
}

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const awards = [
  {
    date:  t('awards.0.date'),
    title: t('awards.0.title'),
    description: t('awards.0.description')
  },
  {
    date:  t('awards.1.date'),
    title: t('awards.1.title'),
    description: t('awards.1.description')
  },
  {
    date:  t('awards.2.date'),
    title: t('awards.2.title'),
    description: t('awards.2.description')
  },
  {
    date:  t('awards.3.date'),
    title: t('awards.3.title'),
    description: t('awards.3.description')
  }
];
---
<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-12 awards-section-container overflow-hidden">
  <h2 class="section-title" set:html={t('awards.title')}></h2>

  <div class="desktop-awards hidden md:block space-y-0 relative mt-8">
    <svg id="awards-connector-svg" class="pointer-events-none absolute top-0 left-0 w-full h-full z-0"></svg>
    {awards.map((award, idx) => (
      <div
        class="relative flex items-center mb-24 desktop-award-entry group"
        data-side={idx % 2 === 0 ? 'left' : 'right'}
      >
        {/* Premio en lado izquierdo (par) */}
        {idx % 2 === 0 ? (
          <>
            <div class="flex-1 flex justify-end">
              <div class="max-w-xs text-left bg-white border border-gray-200 shadow-lg shadow-gray-200/40 p-6 desktop-award-card transition-transform transition-shadow duration-300 ease-out group-[.animate-in]:animate-in group-hover:scale-105 group-hover:shadow-2xl group-hover:rotate-1 relative overflow-visible space-y-2 border-b-2 border-black">
                <div class="text-xs text-gray-500 uppercase tracking-widest mb-1">{award.date}</div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-2xl font-extrabold text-black tracking-tight mb-2">{award.title}</h3>
                </div>
                <hr class="border-t border-gray-200 my-2" />
                <p class="text-base text-gray-700">{award.description}</p>
              </div>
            </div>
            <div class="flex items-center ml-6 relative z-10">
              <div class="bg-white p-1">
                <img src="/logo_pre.svg" alt="Logo" class="w-10 h-10" />
              </div>
            </div>
          </>
        ) : (
          /* Premio en lado derecho (impar) */
          <>
            <div class="flex items-center mr-6 relative z-10">
              <div class="bg-white p-1">
                <img src="/logo_pre.svg" alt="Logo" class="w-10 h-10" />
              </div>
            </div>
            <div class="flex-1 flex justify-start">
              <div class="max-w-xs text-left bg-white border border-gray-200 shadow-lg shadow-gray-200/40 p-6 desktop-award-card transition-transform transition-shadow duration-300 ease-out group-[.animate-in]:animate-in group-hover:scale-105 group-hover:shadow-2xl group-hover:rotate-1 relative overflow-visible space-y-2 border-b-2 border-black">
                <div class="text-xs text-gray-500 uppercase tracking-widest mb-1">{award.date}</div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-2xl font-extrabold text-black tracking-tight mb-2">{award.title}</h3>
                </div>
                <hr class="border-t border-gray-200 my-2" />
                <p class="text-base text-gray-700">{award.description}</p>
              </div>
            </div>
          </>
        )}

        {/* SVG conector de curva suave (zigzag) */}
      </div>
    ))}
  </div>

  <div class="mobile-awards md:hidden mt-8">
    <div class="flex flex-col space-y-8">
      {awards.map((award, index) => (
        <div class="mobile-award-card bg-white shadow-md overflow-hidden border border-gray-100" style={`--index: ${index}`}>
          <div class="bg-black p-3 flex items-center">
            <div class="bg-white p-1 mr-3">
              <img src="/logo_pre.svg" alt="Logo" class="w-6 h-6" />
            </div>
            <h3 class="text-white text-lg font-bold">{award.title}</h3>
          </div>
          <div class="p-4">
            <div class="text-xs text-gray-500 mb-2">{award.date}</div>
            <p class="text-sm">{award.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style is:global>
  /* Initial states */
  .desktop-award-entry {
    opacity: 0;
  }
  .desktop-award-entry[data-side="left"] {
    transform: translateX(-50px);
  }
  .desktop-award-entry[data-side="right"] {
    transform: translateX(50px);
  }
  .desktop-award-card {
    opacity: 0;
    transform: scale(0.95);
  }
  .desktop-award-entry.animate-in .desktop-award-card {
    animation: fadeInCard 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes fadeInCard {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .mobile-award-card {
    opacity: 0;
    transform: translateY(30px);
  }

  /* Animation keyframes */
  @keyframes slideInFromLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Animation classes */
  .desktop-award-entry[data-side="left"].animate-in {
    animation: slideInFromLeft 0.8s ease-out forwards;
  }

  .desktop-award-entry[data-side="right"].animate-in {
    animation: slideInFromRight 0.8s ease-out forwards;
  }

  .mobile-award-card.animate-in {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Stagger delays */
  .desktop-award-entry:nth-child(1) { animation-delay: 0s; }
  .desktop-award-entry:nth-child(2) { animation-delay: 0.15s; }
  .desktop-award-entry:nth-child(3) { animation-delay: 0.3s; }
  .desktop-award-entry:nth-child(4) { animation-delay: 0.45s; }

  .mobile-award-card:nth-child(1) { animation-delay: 0s; }
  .mobile-award-card:nth-child(2) { animation-delay: 0.15s; }
  .mobile-award-card:nth-child(3) { animation-delay: 0.3s; }
  .mobile-award-card:nth-child(4) { animation-delay: 0.45s; }

  /* Estilos para la versión de escritorio */
  .awards-section-container .grid {
    margin-bottom: 2rem;
  }

  /* Efectos para las tarjetas en móvil */
  @media (max-width: 767px) {
    .awards-section-container .rounded-lg {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .awards-section-container .rounded-lg:active {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
  }

  /* Efecto hover en los logos */
  .awards-section-container img {
    transition: transform 0.2s ease;
    position: relative;
    z-index: 10;
  }

  .awards-section-container img:hover {
    transform: scale(1.1);
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  .desktop-award-card {
    opacity: 0;
  }
  .desktop-award-entry[data-side="left"] .desktop-award-card.animate-in {
    animation: fadeInLeft 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .desktop-award-entry[data-side="right"] .desktop-award-card.animate-in {
    animation: fadeInRight 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
</style>

<script>
  import gsap from 'gsap';
  document.addEventListener('DOMContentLoaded', () => {
    // === ANIMACIÓN Y OBSERVADOR DE SECCIÓN ===
    const section = document.querySelector('.desktop-awards');
    let hasAnimated = false;

    function animateAwardsAndLines() {
      const cards = document.querySelectorAll('.desktop-award-card');
      const svg = document.getElementById('awards-connector-svg');
      if (!cards.length || !svg) return;
      // Oculta las líneas al inicio
      const lines = svg.querySelectorAll('line');
      lines.forEach(line => {
        try {
          const x1 = line.getAttribute('x1');
          const y1 = line.getAttribute('y1');
          const x2 = line.getAttribute('x2');
          const y2 = line.getAttribute('y2');
          if (x1 && y1 && x2 && y2) {
            const length = line.getTotalLength();
            const dashArray = line.getAttribute('stroke-dasharray') || '20,12';
            line.style.strokeDasharray = dashArray;
            line.style.strokeDashoffset = String(length);
            line.style.opacity = '0';
          }
        } catch (e) {
          // Si el elemento no es renderizable, ignora el error
        }
      });
      // Anima las cards (fade+slide horizontal, stagger)
      cards.forEach((card, idx) => {
        const parent = card.closest('.desktop-award-entry');
        const isLeft = parent && parent.getAttribute('data-side') === 'left';
        gsap.set(card, {opacity: 0, x: isLeft ? -60 : 60, y: 0});
      });
      gsap.to(cards, {
        opacity: 1,
        x: 0,
        duration: 0.7,
        stagger: 0.18,
        ease: 'power3.out',
        onComplete: () => {
          // Cuando termina la animación de las cards, anima las líneas
          lines.forEach((line, i) => {
            gsap.to(line, {
              strokeDashoffset: 0,
              opacity: 1,
              duration: 0.7,
              delay: i * 0.18,
              ease: 'power2.out'
            });
          });
        }
      });
    }
    function resetAwardsAndLines() {
      const cards = document.querySelectorAll('.desktop-award-card');
      const svg = document.getElementById('awards-connector-svg');
      if (!cards.length || !svg) return;
      cards.forEach((card, idx) => {
        const parent = card.closest('.desktop-award-entry');
        const isLeft = parent && parent.getAttribute('data-side') === 'left';
        gsap.set(card, {opacity: 0, x: isLeft ? -60 : 60, y: 0});
      });
      const lines = svg.querySelectorAll('line');
      lines.forEach(line => {
        try {
          const x1 = line.getAttribute('x1');
          const y1 = line.getAttribute('y1');
          const x2 = line.getAttribute('x2');
          const y2 = line.getAttribute('y2');
          if (x1 && y1 && x2 && y2) {
            const length = line.getTotalLength();
            line.style.strokeDashoffset = String(length);
            line.style.opacity = '0';
          }
        } catch (e) {
          // Si el elemento no es renderizable, ignora el error
        }
      });
    }
    // Intersection Observer para reanimar la sección
    if (section) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateAwardsAndLines();
          } else {
            resetAwardsAndLines();
          }
        });
      }, { threshold: 0.3 });
      observer.observe(section);
    }

    // === RESTO DE INICIALIZACIÓN ===
    const initializeAnimations = () => {
      // Create Intersection Observer for animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };
      // Observer for animated elements
      const animationObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          } else {
            // entry.target.classList.remove('animate-in');
          }
        });
      }, observerOptions);
      // Observe desktop awards
      const desktopAwards = document.querySelectorAll('.desktop-award-entry');
      desktopAwards.forEach(award => {
        animationObserver.observe(award);
      });
      // Observe mobile awards
      const mobileAwards = document.querySelectorAll('.mobile-award-card');
      mobileAwards.forEach(award => {
        animationObserver.observe(award);
      });
    };
    initializeAnimations();

    // === DIBUJAR LÍNEAS ENTRE CARDS ===
    function drawAwardLines() {
      const container = document.querySelector('.desktop-awards');
      const svg = document.getElementById('awards-connector-svg');
      if (!container || !svg) return;
      const cards = Array.from(container.querySelectorAll('.desktop-award-card'));
      if (cards.length < 2) return;
      // Limpia SVG
      svg.innerHTML = '';
      // Obtén posición relativa de cada card respecto al contenedor
      const containerRect = container.getBoundingClientRect();
      const points = cards.map(card => {
        const rect = card.getBoundingClientRect();
        return {
          x: rect.left + rect.width / 2 - containerRect.left,
          y: rect.top + rect.height / 2 - containerRect.top
        };
      });
      // Dibuja líneas entre cada par de puntos
      for (let i = 0; i < points.length - 1; i++) {
        const p1 = points[i];
        const p2 = points[i + 1];
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', String(p1.x));
        line.setAttribute('y1', String(p1.y));
        line.setAttribute('x2', String(p2.x));
        line.setAttribute('y2', String(p2.y));
        line.setAttribute('stroke', '#000');
        line.setAttribute('stroke-width', '10');
        line.setAttribute('stroke-linecap', 'square');
        line.setAttribute('stroke-dasharray', '20,12');
        svg.appendChild(line);
      }
    }
    window.addEventListener('resize', drawAwardLines);
    setTimeout(drawAwardLines, 300);

    // Intersection Observer para animar las cards como en BentoGrid
    const desktopAwards = document.querySelectorAll('.desktop-award-entry');
    let cardsAnimated = 0;
    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const card = entry.target.querySelector('.desktop-award-card');
        if (!card) return;
        if (entry.isIntersecting) {
          card.classList.add('animate-in');
          cardsAnimated++;
        } else {
          card.classList.remove('animate-in');
          cardsAnimated = 0;
        }
      });
      // Cuando todas las cards están animadas, animar las líneas con GSAP
      if (cardsAnimated === desktopAwards.length) {
        setTimeout(animateLinesWithGSAP, 350 * desktopAwards.length);
      }
    }, { threshold: 0.5 });
    desktopAwards.forEach(award => cardObserver.observe(award));

    function animateLinesWithGSAP() {
      const svg = document.getElementById('awards-connector-svg');
      if (!svg) return;
      const lines = svg.querySelectorAll('line');
      lines.forEach(line => {
        const length = line.getTotalLength();
        const dashArray = line.getAttribute('stroke-dasharray') || '20,12';
        line.style.strokeDasharray = dashArray;
        line.style.strokeDashoffset = String(length);
        line.style.opacity = '0';
      });
      lines.forEach((line, i) => {
        gsap.to(line, {
          strokeDashoffset: 0,
          opacity: 1,
          duration: 1,
          delay: i * 0.25,
          ease: 'power2.out'
        });
      });
    }
  });
</script>