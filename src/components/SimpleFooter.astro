---
const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const currentYear = new Date().getFullYear();
---
<footer class="bg-black text-white">
    <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8 flex justify-end items-center">

    <div class="text-sm text-gray-400">
            &copy; {currentYear} OSIX Tech Development SL. {t('footer.copyright')}
    </div>
  </div>
</footer>
