---
import { getAllProducts } from '../data/products-multilingual';
import ProductShowcase from './ProductShowcase.jsx';

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const products = getAllProducts(lang);

const productImages: Record<string, string> = {
  apec: '/products/apec.jpg',
  nessie: '/products/nessie.jpg',
  moura: '/products/moura.jpg',
  acta: '/products/acta.jpg',
  iris: '/products/iris.jpg',
  bond: '/products/bond.jpg',
};

const productsForClient = products.map(p => ({
  id: p.id,
  title: p.title,
  tagline: p.tagline,
  description: p.description,
}));
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={t('products.title')} />

    <ProductShowcase
      products={productsForClient}
      images={productImages}
      viewMoreText={t('products.viewMore')}
      lang={lang}
      client:visible
    />
  </div>
</section>

<style is:global>
  .product-showcase {
    overflow: hidden;
  }

  .product-showcase-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Progress bars — top, full width */
  .product-showcase-bars {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
  }

  .product-showcase-bar-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .product-showcase-bar-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.3s ease;
    text-transform: uppercase;
  }

  .product-showcase-bar-group.active .product-showcase-bar-name,
  .product-showcase-bar-group:hover .product-showcase-bar-name {
    color: black;
  }

  .product-showcase-bar {
    height: 2px;
    background: rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .product-showcase-bar-fill {
    position: absolute;
    inset: 0;
    background: black;
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* Left: carousel */
  .product-showcase-left {
    display: flex;
    flex-direction: column;
  }

  .product-showcase-viewport {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f5f5f5;
    position: relative;
  }

  .product-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right: text */
  .product-showcase-right {
    padding-top: 0.5rem;
  }

  .product-showcase-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: black;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .product-showcase-tagline {
    font-size: 1.1rem;
    color: rgba(0, 0, 0, 0.5);
    font-weight: 500;
  }

  .product-showcase-divider {
    width: 100%;
    height: 1px;
    background: rgba(0, 0, 0, 0.12);
    margin: 1.5rem 0;
  }

  .product-showcase-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.65);
  }

  .product-showcase-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    padding: 0.85rem 2rem;
    background: black;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: background 0.3s ease;
    text-decoration: none;
  }

  .product-showcase-cta:hover {
    background: #333;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .product-showcase-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-showcase-bar-name {
      font-size: 0.65rem;
    }

    .product-showcase-title {
      font-size: 1.75rem;
    }

    .product-showcase-desc {
      font-size: 0.875rem;
    }
  }
</style>
