---
import { getAllProducts } from '../data/products-multilingual';

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const products = getAllProducts(lang);

const productImages: Record<string, string> = {
  apec: '/products/apec.jpg',
  nessie: '/products/nessie.jpg',
  moura: '/products/moura.jpg',
  acta: '/products/acta.jpg',
  iris: '/products/iris.jpg',
  bond: '/products/bond.jpg',
};
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={t('products.title')} />

    <div class="product-list flex flex-col">
      {products.map((product, index) => (
        <a
          href={`/${lang}/productos/${product.id}`}
          class="product-item relative overflow-hidden h-48 md:h-56 group block opacity-0"
          style={`--card-index: ${index}`}
        >
          <img
            src={productImages[product.id] || '/products/default.jpg'}
            alt={product.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="product-item-overlay"></div>
          <div class="relative z-10 flex items-center justify-between h-full px-6 md:px-12">
            <div>
              <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white">{product.title}</h3>
              <p class="mt-1 text-sm md:text-base text-white/75">{product.tagline}</p>
            </div>
            <div class="product-item-cta text-white text-sm font-semibold flex items-center gap-2">
              {t('products.viewMore')}
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .product-item-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    transition: background 0.5s ease;
  }

  .product-item:hover .product-item-overlay {
    background: rgba(0, 0, 0, 0.5);
  }

  .product-item {
    opacity: 0;
    transform: translateX(-60px);
  }

  .product-item.animate-in {
    animation: slideInFromLeft 0.6s ease-out forwards;
    animation-delay: calc(var(--card-index, 0) * 0.1s);
  }

  .product-item-cta {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .product-item:hover .product-item-cta {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes slideInFromLeft {
    from { opacity: 0; transform: translateX(-60px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initializeAnimations = () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.product-item').forEach(card => observer.observe(card));
    };

    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>
