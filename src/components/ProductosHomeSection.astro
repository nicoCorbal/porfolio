---
import { getAllProducts } from '../data/products-multilingual';
import ProductShowcase from './ProductShowcase.jsx';

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const products = getAllProducts(lang);

const productImages: Record<string, string> = {
  apec: '/products/apec.jpg',
  nessie: '/products/nessie.jpg',
  moura: '/products/moura.jpg',
  acta: '/products/acta.jpg',
  iris: '/products/iris.jpg',
  bond: '/products/bond.jpg',
};

const productsForClient = products.map(p => ({
  id: p.id,
  title: p.title,
  tagline: p.tagline,
  description: p.description,
}));
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={t('products.title')} />

    <ProductShowcase
      products={productsForClient}
      images={productImages}
      viewMoreText={t('products.viewMore')}
      lang={lang}
      client:visible
    />
  </div>
</section>

<style is:global>
  .product-showcase {
    overflow: visible;
  }

  /* Progress bars */
  .product-showcase-bars {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .product-showcase-bar-group {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .product-showcase-bar-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(0, 0, 0, 0.3);
    transition: color 0.3s ease;
    text-transform: uppercase;
  }

  .product-showcase-bar-group.active .product-showcase-bar-name,
  .product-showcase-bar-group:hover .product-showcase-bar-name {
    color: black;
  }

  .product-showcase-bar {
    height: 2px;
    background: rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .product-showcase-bar-fill {
    position: absolute;
    inset: 0;
    background: black;
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* Full-bleed image wrapper */
  .product-showcase-content {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    position: relative;
  }

  /* Full-width image container */
  .product-showcase-viewport {
    display: block;
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: #000;
    text-decoration: none;
  }

  .product-showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .product-showcase-viewport:hover .product-showcase-img {
    transform: scale(1.03);
  }


  /* Gradient overlay — bottom fade to black */
  .product-showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 25%,
      rgba(0, 0, 0, 0.15) 45%,
      rgba(0, 0, 0, 0.7) 75%,
      rgba(0, 0, 0, 0.92) 100%
    );
    pointer-events: none;
  }

  /* Text card overlaid at bottom */
  .product-showcase-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2.5rem max(3rem, calc((100vw - 80rem) / 2 + 3rem));
    color: white;
    z-index: 4;
  }

  .product-showcase-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .product-showcase-tagline {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
  }

  .product-showcase-divider {
    width: 60px;
    height: 2px;
    background: rgba(255, 255, 255, 0.3);
    margin: 1.2rem 0;
  }

  .product-showcase-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.75);
    max-width: 700px;
  }

  .product-showcase-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1.8rem;
    background: white;
    color: black;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .product-showcase-viewport:hover .product-showcase-cta {
    background: #f0f0f0;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .product-showcase-bar-name {
      font-size: 0.65rem;
    }

    .product-showcase-viewport {
      aspect-ratio: 4 / 3;
    }

    .product-showcase-text {
      padding: 1.5rem;
    }

    .product-showcase-title {
      font-size: 1.5rem;
    }

    .product-showcase-tagline {
      font-size: 0.95rem;
    }

    .product-showcase-desc {
      font-size: 0.85rem;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-showcase-cta {
      padding: 0.6rem 1.4rem;
      font-size: 0.75rem;
    }
  }
</style>
