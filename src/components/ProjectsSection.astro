---
import { getAllProjects } from '../data/projects-multilingual';

const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const texts = {
  title: t('projects.title'),
  client: t('projects.client'),
};

const projects = getAllProjects(lang);
const projectsData = projects.map(project => ({
  title: project.title,
  category: project.category,
  image: project.images[0],
  url: `/${lang}/projects/${project.id}`
}));

const initialProjectCount = 3;
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={texts.title} />

    <div class="project-list flex flex-col gap-4">
      {projectsData.map((project, index) => (
        <a
          href={project.url}
          class={
            `project-item relative overflow-hidden h-48 md:h-56 group block opacity-0 ` +
            (index >= initialProjectCount ? "extra-project hidden" : "")
          }
        >
          {/* Imagen de fondo */}
          <img
            src={project.image}
            alt={project.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
    
          {/* Capa de color para legibilidad */}
          <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/10 to-transparent"></div>
    
          {/* Contenido */}
          <div class="relative z-10 flex items-center justify-between h-full px-6 md:px-12">
            <div>
              <h3 class="text-3xl sm:text-3xl md:text-4xl font-semibold text-white">
                {project.title}
              </h3>
              <p class="mt-2 text-lg text-gray-200">{project.category}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    {projectsData.length > initialProjectCount && (
      <div class="mt-16 md:mt-20 text-center space-x-4">
        <button id="show-more-btn" class="text-lg md:text-xl font-semibold text-gray-800 border-2 border-gray-800 px-6 md:px-8 py-2 md:py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300">
          {t('projects.showMore')}
        </button>
        <button id="show-less-btn" class="text-lg md:text-xl font-semibold text-gray-800 border-2 border-gray-800 px-6 md:px-8 py-2 md:py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300 hidden">
          {t('projects.showLess')}
        </button>
      </div>
    )}
  </div>
</section>

<style>
  /* CSS Animations */
  @keyframes slideInFromLeft {
    from {
      opacity: 0;
      transform: translateX(-60px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-item {
    opacity: 0;
    transform: translateY(30px);
  }

  .project-item.animate-in {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Stagger animation delays */
  .project-item:nth-child(1) { animation-delay: 0.1s; }
  .project-item:nth-child(2) { animation-delay: 0.2s; }
  .project-item:nth-child(3) { animation-delay: 0.3s; }
  .project-item:nth-child(4) { animation-delay: 0.4s; }
  .project-item:nth-child(5) { animation-delay: 0.5s; }
  .project-item:nth-child(6) { animation-delay: 0.6s; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const initializeAnimations = () => {
      // Create Intersection Observer for animations
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
      };

      // Observer for animated elements
      const animationObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          } else {
            entry.target.classList.remove('animate-in');
          }
        });
      }, observerOptions);

      // Observe section title
      const sectionTitle = document.querySelector('.section-title');
      if (sectionTitle) {
        animationObserver.observe(sectionTitle);
      }

      // Observe all project items
      const projectItems = document.querySelectorAll('.project-item:not(.hidden)');
      projectItems.forEach(item => {
        animationObserver.observe(item);
      });

      // Show More/Less button logic
      const showMoreBtn = document.getElementById('show-more-btn');
      const showLessBtn = document.getElementById('show-less-btn');
      const extraProjects = document.querySelectorAll('.extra-project');

      if (showMoreBtn && showLessBtn) {
        showMoreBtn.addEventListener('click', () => {
          showMoreBtn.classList.add('hidden');
          
          // Show extra projects and observe them
          extraProjects.forEach((item, index) => {
            item.classList.remove('hidden');
            // Reset animation state
            item.classList.remove('animate-in');
            // Add delay
            (item as HTMLElement).style.animationDelay = `${(index + 4) * 0.1}s`;
            // Start observing
            animationObserver.observe(item);
          });
          
          showLessBtn.classList.remove('hidden');
        });

        showLessBtn.addEventListener('click', () => {
          showLessBtn.classList.add('hidden');
          
          // Hide extra projects
          extraProjects.forEach(item => {
            item.classList.add('hidden');
            item.classList.remove('animate-in');
            animationObserver.unobserve(item);
          });
          
          showMoreBtn.classList.remove('hidden');
        });
      }
    };

    // Wait for loading screen to complete
    if ((window as any).isLoadingComplete) {
      initializeAnimations();
    } else {
      window.addEventListener('loadingComplete', initializeAnimations);
    }
  });
</script>
