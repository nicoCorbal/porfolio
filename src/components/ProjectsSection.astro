---
const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const texts = {
  title: t('projects.title'),
  client: t('projects.client'),
};

interface Project {
    title: string;
    category: string;
    image: ImageMetadata | string;
    url: string;
}
  
const projectsData: Project[] = [
  {
    title: "Nessie Assistant",
    category: t('projects.categories.ai_assistant'),
    image: "/projects/nessie.jpg",
   url: `/${lang}/projects/nessie`
  },
  {
    title: "Echoia Notetaker",
    category: t('projects.categories.ai_tool'),
    image: "/projects/echoia.jpg",
   url: `/${lang}/projects/echoia`
  },
  {
    title: "Kharon Proxy",
    category: t('projects.categories.cyber_tool'),
    image: "/projects/kharon.jpg",
   url: `/${lang}/projects/kharon`
  },
  
];

const initialProjectCount = 3;
---

<section class="section bg-white text-black">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={texts.title} />

    <div class="project-list flex flex-col gap-4 border-t border-gray-300">
      {projectsData.map((project, index) => (
        <a
          href={project.url}
          class={
            `project-item relative overflow-hidden h-48 md:h-56 group block ` +
            (index >= initialProjectCount ? "extra-project hidden" : "")
          }
        >
          {/* Imagen de fondo */}
          <img
            src={typeof project.image === 'string' ? project.image : project.image.src}
            alt={project.title}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
    
          {/* Capa de color para legibilidad */}
          <div class="absolute inset-0 bg-black/40"></div>
    
          {/* Contenido */}
          <div class="relative z-10 flex items-center justify-between h-full px-6 md:px-12">
            <div>
              <h3 class="text-3xl sm:text-3xl md:text-4xl font-semibold text-white">
                {project.title}
              </h3>
              <p class="mt-2 text-lg text-gray-200">{project.category}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    {projectsData.length > initialProjectCount && (
      <div class="mt-16 md:mt-20 text-center space-x-4">
        <button id="show-more-btn" class="text-lg md:text-xl font-semibold text-gray-800 border-2 border-gray-800 px-6 md:px-8 py-2 md:py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300">
          {t('projects.showMore')}
        </button>
        <button id="show-less-btn" class="text-lg md:text-xl font-semibold text-gray-800 border-2 border-gray-800 px-6 md:px-8 py-2 md:py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300 hidden">
          {t('projects.showLess')}
        </button>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // --- "Show More/Less" button logic ---
    const showMoreBtn = document.getElementById('show-more-btn');
    const showLessBtn = document.getElementById('show-less-btn');
    const extraProjects = gsap.utils.toArray<HTMLElement>('.extra-project');

    const setupEntranceAnimation = (items: HTMLElement[]) => {
      items.forEach(item => {
        gsap.from(item, {
          opacity: 0,
          y: 50,
          duration: 0.8,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: item,
            start: 'top 90%',
            toggleActions: 'play none none none',
          },
        });
      });
    };

    const initialItems = gsap.utils.toArray<HTMLElement>('.project-item:not(.hidden)');
    setupEntranceAnimation(initialItems);

    if (showMoreBtn && showLessBtn) {
      showMoreBtn.addEventListener('click', () => {
        extraProjects.forEach(item => item.classList.remove('hidden'));
        setupEntranceAnimation(extraProjects);
        showMoreBtn.classList.add('hidden');
        showLessBtn.classList.remove('hidden');
        setTimeout(() => ScrollTrigger.refresh(), 200);
      });

      showLessBtn.addEventListener('click', () => {
        showLessBtn.classList.add('hidden');
        gsap.to(extraProjects, {
          opacity: 0, y: -30, height: 0, paddingTop: 0, paddingBottom: 0,
          stagger: 0.1, duration: 0.6, ease: 'power2.in',
          onComplete: () => {
            extraProjects.forEach(item => {
              item.classList.add('hidden');
              gsap.set(item, { clearProps: 'all' });
            });
            showMoreBtn.classList.remove('hidden');
            setTimeout(() => ScrollTrigger.refresh(), 100);
          },
        });
      });
    }

    // --- GSAP Hover-to-Expand Project Items ---
    /*
    const allProjects = gsap.utils.toArray<HTMLElement>('.project-item');

    allProjects.forEach(project => {
      const detailsContent = project.querySelector<HTMLElement>('.details-content');
      const icon = project.querySelector('.icon-wrapper');
      
      if (!detailsContent || !icon) return;

      const animation = gsap.timeline({ paused: true });

      animation
        .to(detailsContent, {
          height: 'auto',
          duration: 0.6,
          ease: 'expo.inOut',
        })
        .to(icon, {
          rotation: 45,
          duration: 0.4,
          ease: 'power2.out',
        }, '<');

      project.addEventListener('mouseenter', () => {
        animation.play();
      });

      project.addEventListener('mouseleave', () => {
        animation.reverse();
      });
    });
    */
  });
</script>
