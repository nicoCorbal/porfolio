---
import { getImage } from "astro:assets";
import opillsImage from "../assets/projects/opills.jpg";
import onoteImage from "../assets/projects/onote.jpg";
import wearendarImage from "../assets/projects/wearendar.jpeg";

const { lang } = Astro.params;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const texts = {
  title: t('projects.title'),
  client: t('projects.client'),
};

interface Project {
    title: string;
    category: string;
    image: ImageMetadata | string;
    video?: string;
    client: string,
    url: string;
}
  
const projectsData: Project[] = [
  {
    title: "Web oPills",
    category: "Web Design",
    image: opillsImage,
    client: "oPills",
    url: "https://opills.app/"
  },
  {
    title: "oNote",
    category: "Mobile App",
    image: onoteImage,
    video: "/videos/onote.mp4",
    client: "oNote",
    url: "https://github.com/ppazosp/oNote/"
  },
  {
    title: "Wearendar",
    category: "Mobile App",
    image: wearendarImage,
    video: "/videos/wearendar.mp4",
    client: "Wearendar",
    url: "https://github.com/SrFreiRe/wearendar/"
  }
];

const optimizedProjects = await Promise.all(
  projectsData.map(async (project) => {
    const optimizedImage = await getImage({
      src: project.image as ImageMetadata,
      width: 1024,
      height: 768,
      format: "webp",
      quality: 80,
    });
    return {
      ...project,
      image: optimizedImage.src,
    };
  })
);
---

<div class="w-full max-w-7xl mx-auto px-6 md:px-12 py-20">
  <h2 class="section-title" set:html={texts.title} />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
    {optimizedProjects.map(project => (
      <a href={project.url} target="_blank" rel="noopener noreferrer" class="block rounded-lg overflow-hidden shadow-lg group transform hover:-translate-y-1 transition-transform duration-300">
        <div class="relative">
          <img src={project.image} alt={project.title} class="w-full h-56 object-cover" />
          <div class="absolute inset-0 bg-black/20"></div>
        </div>
        <div class="p-6 bg-white">
          <span class="inline-block mb-2 text-xs font-medium text-blue-600 bg-blue-100 px-3 py-1 rounded-full">
            {project.category}
          </span>
          <h3 class="text-xl font-bold text-gray-900 mb-1">{project.title}</h3>
          <p class="text-gray-600 text-sm">{texts.client}: {project.client}</p>
        </div>
      </a>
    ))}
  </div>
</div>
