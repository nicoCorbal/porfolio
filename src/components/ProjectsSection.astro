---
const { lang = 'es' } = Astro.props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

const texts = {
  title: t('projects.title'),
  client: t('projects.client'),
};

interface Project {
    title: string;
    category: string;
    image: ImageMetadata | string;
    url: string;
}
  
const projectsData: Project[] = [
  {
    title: "Nessie Assistant",
    category: "AI Assistant",
    image: "/projects/nessie.jpg",
   url: `/${lang}/projects/nessie`
  },
  {
    title: "Echoia Notetaker",
    category: "AI Tool",
    image: "/projects/echoia.jpg",
   url: `/${lang}/projects/echoia`
  },
  {
    title: "Kharon Proxy",
    category: "Cyber Tool",
    image: "/projects/kharon.jpg",
   url: `/${lang}/projects/kharon`
  },
  
];

const initialProjectCount = 3;
---

<section class="section bg-white text-black py-16 md:py-20 overflow-hidden">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title" set:html={texts.title} />

    <div class="project-list flex flex-col gap-4 mt-16 border-t border-gray-300">
      {projectsData.map((project, index) => (
        <a
          href={project.url}
          class={
            `project-item relative overflow-hidden rounded-lg h-48 md:h-56 group block ` +
            (index >= initialProjectCount ? "extra-project hidden" : "")
          }
        >
          {/* Imagen de fondo */}
          <img
            src={typeof project.image === 'string' ? project.image : project.image.src}
            alt={project.title}
            data-view-transition-name={`proj-${project.title.toLowerCase().replace(/\s+/g, '-')}`}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
    
          {/* Capa de color para legibilidad */}
          <div class="absolute inset-0 bg-black/40"></div>
    
          {/* Contenido */}
          <div class="relative z-10 flex items-center justify-between h-full px-6 md:px-12">
            <div>
              <h3 class="text-3xl sm:text-3xl md:text-4xl font-semibold text-white">
                {project.title}
              </h3>
              <p class="mt-2 text-lg text-gray-200">{project.category}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    {projectsData.length > initialProjectCount && (
      <div class="mt-16 md:mt-20 text-center space-x-4">
        <button id="show-more-btn" class="text-xl font-semibold text-gray-800 border-2 border-gray-800 rounded-full px-8 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300">
          {t('projects.showMore')}
        </button>
        <button id="show-less-btn" class="text-xl font-semibold text-gray-800 border-2 border-gray-800 rounded-full px-8 py-3 hover:bg-gray-800 hover:text-white transition-colors duration-300 hidden">
          {t('projects.showLess')}
        </button>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // --- "Show More/Less" button logic ---
    const showMoreBtn = document.getElementById('show-more-btn');
    const showLessBtn = document.getElementById('show-less-btn');
    const extraProjects = gsap.utils.toArray<HTMLElement>('.extra-project');

    const animateIn = (items: HTMLElement[]) => {
      gsap.from(items, {
        opacity: 0, y: 60, duration: 1, stagger: 0.1, ease: 'power3.out',
        scrollTrigger: {
          trigger: items[0],
          start: 'top 90%',
          toggleActions: 'play none none none',
        },
      });
    };
    
    const initialItems = gsap.utils.toArray<HTMLElement>('.project-item:not(.hidden)');
    if (initialItems.length > 0) animateIn(initialItems);
    
    if (showMoreBtn && showLessBtn) {
      showMoreBtn.addEventListener('click', () => {
        extraProjects.forEach(item => item.classList.remove('hidden'));
        animateIn(extraProjects);
        showMoreBtn.classList.add('hidden');
        showLessBtn.classList.remove('hidden');
        setTimeout(() => ScrollTrigger.refresh(), 200);
      });

      showLessBtn.addEventListener('click', () => {
        showLessBtn.classList.add('hidden');
        gsap.to(extraProjects, {
          opacity: 0, y: -30, height: 0, paddingTop: 0, paddingBottom: 0,
          stagger: 0.1, duration: 0.6, ease: 'power2.in',
          onComplete: () => {
            extraProjects.forEach(item => {
              item.classList.add('hidden');
              gsap.set(item, { clearProps: 'all' });
            });
            showMoreBtn.classList.remove('hidden');
            setTimeout(() => ScrollTrigger.refresh(), 100);
          },
        });
      });
    }

    // --- Polished & Robust GSAP Accordion ---
    const allDetails = gsap.utils.toArray<HTMLDetailsElement>('.project-item');

    const closeDetails = (details: HTMLDetailsElement) => {
      const content = details.querySelector<HTMLElement>('.details-content');
      if (!content) return;
      const innerContent = gsap.utils.toArray<HTMLElement>(content.querySelectorAll('div, p, a'));

      return gsap.timeline({
        onComplete: () => {
          details.removeAttribute('open');
          // THIS IS THE FIX: Reset properties so it can be opened again.
          gsap.set(innerContent, { clearProps: "opacity,transform" });
        }
      })
      .to(innerContent, {
        opacity: 0,
        y: -10,
        stagger: 0.05,
        duration: 0.2,
        ease: 'power1.in'
      })
      .to(content, {
        height: 0,
        opacity: 0,
        duration: 0.4,
        ease: 'expo.inOut'
      }, '-=0.1');
    };

    allDetails.forEach(details => {
      const summary = details.querySelector('summary');
      const content = details.querySelector<HTMLElement>('.details-content');
      if (!summary || !content) return;

      gsap.set(content, { height: 0, opacity: 0 }); // Start closed

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        if (isOpen) {
          closeDetails(details);
        } else {
          // First, close any other open accordion
          allDetails.forEach(otherDetails => {
            if (otherDetails !== details && otherDetails.hasAttribute('open')) {
              closeDetails(otherDetails);
            }
          });

          // Then, open the clicked one
          details.setAttribute('open', '');
          const innerContent = gsap.utils.toArray<HTMLElement>(content.querySelectorAll('div, p, a'));
          
          gsap.timeline({ onComplete: () => ScrollTrigger.refresh() })
            .to(content, {
              height: 'auto',
              opacity: 1,
              duration: 0.6,
              ease: 'expo.inOut'
            })
            .from(innerContent, {
              opacity: 0,
              y: 10,
              stagger: 0.06,
              duration: 0.4,
              ease: 'power1.out'
            }, '-=0.3');
        }
      });
    });
  });
</script>
