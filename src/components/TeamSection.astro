import mateoImg from '../assets/team/mateo.jpeg';
import juanImg from '../assets/team/juan.jpeg';
import gutiImg from '../assets/team/guti.jpeg';
import pazosImg from '../assets/team/pazos.jpeg';
import nicoImg from '../assets/team/nico.jpeg';
import nelImg from '../assets/team/nel.jpeg';
import diegoImg from '../assets/team/diego.jpeg';

const teamMembers = [
  { 
    name: "Mateo", 
    role: "CFO", 
    image: mateoImg, 
    linkedin: "https://www.linkedin.com/in/mateo-bodenlle-villarino/", 
    github: "https://github.com/mateobodenlle",
    description: "Drives OSIX’s financial vision and growth strategy. With a sharp eye for opportunity and risk, Mateo leads fundraising efforts, financial planning, and long-term sustainability to ensure each step the company takes is strategically sound."
  },
  { 
    name: "Juan", 
    role: "Backend Engineer", 
    image: juanImg, 
    linkedin: "https://www.linkedin.com/in/juan-freire-alvarez/", 
    github: "https://github.com/SrFreiRe",
    description: "Designs and implements the backbone of our systems. Juan is an expert in high-performance APIs, database optimization, and backend scalability, ensuring OSIX’s platforms are as solid as they are flexible."
  },
  { 
    name: "Guti", 
    role: "Security & AI Backend Engineer", 
    image: gutiImg, 
    linkedin: "https://www.linkedin.com/in/david-gutierrez-cs/", 
    github: "https://github.com/dav1dgf",
    description: "Merges cybersecurity best practices with advanced AI integration. Guti thrives in high-pressure environments, building secure backend systems and deploying AI-powered solutions that handle real-world complexity with elegance."
  },
  { 
    name: "Pazos", 
    role: "CTO / Software Architect", 
    image: pazosImg, 
    linkedin: "https://www.linkedin.com/in/pablo-pazos-parada/", 
    github: "https://github.com/ppazosp",
    description: "Defines the technical direction and system architecture behind OSIX. As CTO, Pazos leads the team toward clean, modular, and scalable solutions, balancing long-term strategy with day-to-day decision-making across all tech fronts."
  },
  { 
    name: "Nico", 
    role: "Frontend Engineer", 
    image: nicoImg, 
    linkedin: "https://www.linkedin.com/in/nicol%C3%A1s-corbal-912929318/", 
    github: "https://github.com/nicoCorbal",
    description: "Crafts intuitive, pixel-perfect user interfaces. Nico transforms complex functionality into sleek, interactive experiences, leveraging the latest frontend technologies to create smooth and engaging user journeys."
  },
  { 
    name: "Nel", 
    role: "DevOps Engineer", 
    image: nelImg, 
    linkedin: "https://www.linkedin.com/in/david-manuel-raposeiras-canabal-a95028210/", 
    github: "https://github.com/davrapcan",
    description: "Automates, monitors, and secures the backbone of OSIX’s infrastructure. Nel ensures that deployments are fast, environments are resilient, and systems stay online — always with security and performance in mind."
  },
  { 
    name: "Diego", 
    role: "Full Stack Mobile Engineer", 
    image: diegoImg, 
    linkedin: "https://www.linkedin.com/in/diego-cristobal-andaluz-3a5580304/", 
    github: "https://github.com/2cristo7",
    description: "Bridges mobile and web development with a unified approach. Diego builds consistent, high-quality user experiences across platforms, using full-stack capabilities to deliver features with speed and precision."
  },
];
---
<section class="section bg-white text-black py-20 overflow-x-hidden">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12">
    <h2 class="section-title">Our <span class="font-bold">Team</span></h2>

    <!-- Desktop: Expanding Cards -->
    <div class="hidden md:block overflow-hidden">
      <div class="flex w-full h-[75vh] max-h-[700px] mt-16 gap-4 team-expanding-cards-container">
        {teamMembers.map((member) => (
          <div class="team-card flex-1 relative rounded-lg overflow-hidden cursor-pointer shadow-lg border border-gray-200/50">
            <Image src={member.image} alt={member.name} class="w-full h-full object-cover" loading="lazy" decoding="async" format="webp" />
            <div class="card-overlay absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
            <div class="card-content absolute bottom-0 left-0 p-6 text-white w-full">
              <h3 class="text-2xl font-bold translate-y-5 opacity-0">{member.name}</h3>
              <div class="details w-full mt-4 translate-y-5 opacity-0">
                <p class="text-md font-semibold text-white/90">{member.role}</p>
                <p class="text-sm text-white/80 mt-2 max-w-md">{member.description}</p>
                <div class="flex gap-4 mt-4">
                  <a href={member.linkedin} target="_blank" class="text-white/70 hover:text-white transition">
                    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.25 6.5 1.75 1.75 0 016.5 8.25zM19 19h-3v-4.74c0-1.42-.6-2.13-1.58-2.13-1.07 0-1.92.8-1.92 2.13V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.42c2.4 0 3.4 1.58 3.4 4.63z"/></svg>
                  </a>
                  <a href={member.github} target="_blank" class="text-white/70 hover:text-white transition">
                    <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: Native HTML Accordion -->
    <div class="block md:hidden mt-8 space-y-4">
      {teamMembers.map((member) => (
        <details class="bg-gray-50 rounded-lg overflow-hidden border border-gray-200/60 group">
          <summary class="flex items-center p-4 cursor-pointer list-none">
            <Image src={member.image} alt={member.name} class="w-16 h-16 rounded-full object-cover flex-shrink-0" loading="lazy" decoding="async" format="webp" width={64} height={64} />
            <div class="ml-4">
              <h3 class="font-bold text-lg">{member.name}</h3>
              <p class="text-gray-600">{member.role}</p>
            </div>
            <div class="ml-auto">
              <svg class="w-6 h-6 text-gray-400 transition-transform duration-300 group-open:rotate-180" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M11.9999 13.1714L16.9497 8.22168L18.3639 9.63589L11.9999 15.9999L5.63599 9.63589L7.0502 8.22168L11.9999 13.1714Z"></path></svg>
            </div>
          </summary>
          <div class="p-4 pt-0 border-t border-gray-200/60">
            <p class="text-gray-700 mb-4">{member.description}</p>
            <div class="flex gap-4">
              <a href={member.linkedin} target="_blank" class="text-gray-500 hover:text-black transition">
                <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.25 6.5 1.75 1.75 0 016.5 8.25zM19 19h-3v-4.74c0-1.42-.6-2.13-1.58-2.13-1.07 0-1.92.8-1.92 2.13V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.42c2.4 0 3.4 1.58 3.4 4.63z"/></svg>
              </a>
              <a href={member.github} target="_blank" class="text-gray-500 hover:text-black transition">
                <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { Flip } from "gsap/Flip";

  // --- Desktop expanding cards ---
  function setupExpandingCards() {
    if (window.innerWidth < 768) return; // Don't run on mobile

    gsap.registerPlugin(Flip);

    const container = document.querySelector<HTMLElement>(".team-expanding-cards-container");
    if (!container) return;
    
    const cards = gsap.utils.toArray<HTMLElement>(".team-card");
    let activeCard: HTMLElement | null = null;

    const animateContent = (card: HTMLElement, direction: 'in' | 'out') => {
      const title = card.querySelector('h3');
      const details = card.querySelector('.details');
      const overlay = card.querySelector('.card-overlay');

      gsap.killTweensOf([title, details, overlay]);

      gsap.to(overlay, {
        opacity: direction === 'in' ? 1 : 0.8,
        duration: 0.6,
        ease: 'expo.out',
      });

      gsap.to([title, details], {
        y: direction === 'in' ? 0 : 20,
        skewX: direction === 'in' ? 0 : -5,
        opacity: direction === 'in' ? 1 : 0,
        duration: 0.5,
        stagger: direction === 'in' ? 0.08 : 0.05,
        ease: 'expo.out'
      });
    }
    
    // Initial state: all cards are collapsed
    cards.forEach(card => {
      gsap.set(card, { flexGrow: 1 });
      const overlay = card.querySelector('.card-overlay');
      if(overlay) gsap.set(overlay, { opacity: 0.8 });
      const title = card.querySelector('h3');
      const details = card.querySelector('.details');
      if(title && details) {
        gsap.set([title, details], { y: 20, opacity: 0, skewX: -5 });
      }
    });
    
    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        if (card === activeCard) return;
        if (activeCard) {
          animateContent(activeCard, 'out');
        }
        const state = Flip.getState(cards, { props: "flexGrow" });
        cards.forEach(c => {
          gsap.set(c, { flexGrow: c === card ? 10 : 1 });
        });
        Flip.from(state, {
          duration: 0.8,
          ease: "expo.out",
          absolute: true,
        });
        animateContent(card, 'in');
        activeCard = card;
      });
    });

    container.addEventListener('mouseleave', () => {
      if (!activeCard) return;
      animateContent(activeCard, 'out');
      const state = Flip.getState(cards, { props: "flexGrow" });
      cards.forEach(c => {
        gsap.set(c, { flexGrow: 1 });
      });
      Flip.from(state, {
        duration: 0.8,
        ease: 'expo.out',
        absolute: true,
      });
      activeCard = null;
    });
  }

  function debounce<T extends (...args: any[]) => any>(func: T, wait: number) {
    let timeout: ReturnType<typeof setTimeout>;
    return function executedFunction(...args: Parameters<T>) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  function runScripts() {
    setupExpandingCards();
    // Mobile accordion is now native, no JS needed.
  }

  document.addEventListener('astro:page-load', runScripts);
  document.addEventListener('DOMContentLoaded', runScripts);
  window.addEventListener('resize', debounce(runScripts, 200));
</script>
