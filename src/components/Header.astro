---
import { getProjectIds, getProject } from '../data/projects';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props as Props;
const translations = await import(`../../public/locales/${lang}.json`);
const t = (k: string) => translations.default[k] || k;

// Get current page path to determine if we're on a project page
const currentPath = Astro.url.pathname;
const isMainPage = currentPath === `/${lang}/` || currentPath === `/${lang}` || currentPath === '/' || currentPath === '/en' || currentPath === '/es';

// Get all projects for the dropdown
const projectIds = getProjectIds();
const projectItems = projectIds.map(id => {
  const project = getProject(id);
  return {
    id,
    title: project?.title || id,
    href: `/${lang}/projects/${id}`
  };
});

const navItems = [
  { label: t('nav.services'), href: isMainPage ? '#services' : `/${lang}/#services`, scrollAdjust: 0 },
  { label: t('nav.projects'), href: isMainPage ? '#projects' : `/${lang}/#projects`, scrollAdjust: 0, hasDropdown: true },
  { label: t('nav.team'), href: isMainPage ? '#about' : `/${lang}/#about`, scrollAdjust: 0 },
  { label: t('nav.awards'), href: isMainPage ? '#awards' : `/${lang}/#awards`, scrollAdjust: 0 },
];

---

<header class={`fixed w-full z-50 transition-all duration-300 bg-white group/header ${!isMainPage ? 'project-page' : ''}`} id="main-header">
  <div class="px-4 sm:px-6 md:px-12 py-2 sm:py-3 md:py-5">
    <div class="flex items-center justify-between">
      <a href={`/${lang}/`} class="flex items-center z-10 logo-link">
        <img
          src="/full_logo.png"
          alt="OSIX"
          class="h-7 sm:h-7 md:h-8 w-auto transition-transform duration-200"
          id="logo-img"
        />
      </a>
      
      <!-- Navegación principal - Versión desktop -->
      <nav class="hidden md:flex items-center justify-center flex-1">
        <div class="relative flex items-center space-x-1">
          {navItems.map((item, index) => {
            return item.hasDropdown ? (
              <div class="relative group/dropdown nav-dropdown" data-index={index}>
                <a
                  href={item.href}
                  class="relative px-4 sm:px-5 py-2 sm:py-3 text-base text-black sm:text-lg font-semibold transition-all duration-300 nav-item flex items-center gap-1"
                  data-index={index}
                  data-scroll-adjust={item.scrollAdjust}
                >
                  {item.label}
                  <svg class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
              </div>
            ) : (
              <a
                href={item.href}
                class="relative px-4 sm:px-5 py-2 sm:py-3 text-black text-base sm:text-lg font-semibold transition-all duration-300 nav-item"
                data-index={index}
                data-scroll-adjust={item.scrollAdjust}
              >
                {item.label}
              </a>
            );
          })}
          <div id="nav-indicator" class="absolute bottom-0 h-0.5 bg-black rounded-full transition-all duration-300 pointer-events-none opacity-0"></div>
        </div>
      </nav>
      
      <!-- CTA button -->
      <div class="hidden md:block">
        <a href={isMainPage ? '#contact' : `/${lang}/#contact`} class="inline-flex items-center justify-center h-9 sm:h-10 px-4 sm:px-5 py-0 text-sm font-medium bg-black text-white transition-all duration-300 hover:shadow-lg hover:shadow-black/20 hover:scale-105" data-scroll-adjust="-60">
          <span>{t('nav.contact')}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2 -mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Menú móvil -->
      <button id="mobile-toggle" class="md:hidden flex items-center justify-center w-10 h-10 focus:outline-none z-10" aria-label={t('nav.menu.open')} aria-expanded="false">
        <div class="burger-icon">
          <span class="burger-line"></span>
          <span class="burger-line"></span>
        </div>
      </button>
    </div>
  </div>
  
  <!-- Expandable Projects Section -->
  <div class="projects-expansion absolute top-full left-0 w-full bg-white border-t border-gray-100 shadow-lg overflow-hidden transition-all duration-300">
    <div class="px-3 sm:px-2 md:px-12 py-2">
      <div class="flex flex-rown items-center justify-start py-3 gap-24">
        {projectItems.map(project => (
          <a
            href={project.href}
            class="group !max-w-[140px] flex flex-col items-start justify-center transition-all duration-200"
          >
            <h3 class="font-medium text-black group-hover:text-black transition-colors duration-200">{project.title}</h3>
            <p class="text-sm text-gray-600 mt-1">View project →</p>
          </a>
        ))}
      </div>
    </div>
  </div>
  
  <!-- Menú móvil overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-white/95 backdrop-blur-md flex flex-col items-center justify-start pt-20 opacity-0 pointer-events-none transition-all duration-300 z-40 overflow-hidden" aria-hidden="true">
    <!-- Botón de cierre -->
    <button id="mobile-close" class="absolute top-4 right-4 p-2 text-gray-600 hover:text-black transition-colors duration-200" aria-label={t('nav.menu.close')}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <nav class="flex flex-col items-center space-y-6 w-full max-w-md px-4">
      {navItems.map((item, index) => {
        return item.hasDropdown ? (
          <div class="w-full">
            <a
              href={item.href}
              class="text-2xl font-medium text-gray-800 transition-all duration-300 py-3 mobile-nav-item w-full text-center relative group block"
              data-scroll-adjust={item.scrollAdjust}
              style={`--index: ${index}`}
            >
              {item.label}
              <span class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-black transition-all duration-300 transform -translate-x-1/2 group-hover:w-1/2"></span>
            </a>
            <div class="mt-2 space-y-1">
              {projectItems.map(project => (
                <a
                  href={project.href}
                  class="block px-8 py-2 text-lg text-gray-600 hover:text-black transition-colors duration-150"
                >
                  {project.title}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="text-2xl font-medium text-gray-800 transition-all duration-300 py-3 mobile-nav-item w-full text-center relative group"
            data-scroll-adjust={item.scrollAdjust}
            style={`--index: ${index}`}
          >
            {item.label}
            <span class="absolute bottom-0 left-1/2 w-0 h-0.5 bg-black transition-all duration-300 transform -translate-x-1/2 group-hover:w-1/2"></span>
          </a>
        );
      })}
      
      <div class="w-full max-w-xs pt-6">
        <a href={isMainPage ? '#contact' : `/${lang}/#contact`} class="flex items-center justify-center w-full px-6 py-4 text-lg font-medium bg-black text-white transition-all duration-300 hover:opacity-90 hover:scale-105" data-scroll-adjust="-60">
          {t('nav.mobile.contact')}
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </nav>
  </div>

</header>

<script>
  // Script para manejar la navegación interactiva

// Navigation script

  // Prevenir errores de TypeScript
declare global {
  interface Window {
    ontouchstart?: any;
  }
}

document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const heroSection = document.querySelector('section#home') as HTMLElement | null;
    
    // Immediately show header on project pages (no hero section)
    if (!heroSection && header) {
      header.classList.add('visible');
    }

    // Show header only after the hero section scrolls out of view
    function toggleHeaderVisibility() {
      if (!header) return;
      
      // If no hero section exists (like on project pages), always show header
      if (!heroSection) {
        header.classList.add('visible');
        return;
      }

      const heroBottom = heroSection.getBoundingClientRect().bottom;
      const logoContainer = document.getElementById('hero-logo-container');

      if (heroBottom <= header.offsetHeight + 200) {
        header.classList.add('visible');
        if (logoContainer) logoContainer.style.opacity = '0';
      } else {
        header.classList.remove('visible');
        if (logoContainer) logoContainer.style.opacity = '1';
      }
    }
    const navItems = document.querySelectorAll('.nav-item');
    const navIndicator = document.getElementById('nav-indicator');
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileClose = document.getElementById('mobile-close');
    const burgerIcon = document.querySelector('.burger-icon');
    const allNavLinks = document.querySelectorAll('nav .nav-item');
    const logoLink = document.querySelector('.logo-link');
    let isMenuOpen = false;
    let activeNavItem: HTMLElement | null = null;
    let disableIndicatorUpdate = false;
    
    // Projects expansion handling
    const projectsNavItem = document.querySelector('.nav-dropdown');
    const projectsExpansion = document.querySelector('.projects-expansion') as HTMLElement;
    let expansionTimeout: number | null = null;
    
    // Función para actualizar el indicador de navegación y mostrar/ocultar el header según la sección
    function updateIndicatorBySection(sectionId: string) {

      const targetNavItem = document.querySelector(`nav .nav-item[href="#${sectionId}"]`) as HTMLElement;
      if (targetNavItem) {
        activeNavItem = targetNavItem;

        if (navIndicator) {
          // Check if this is a dropdown item
          const dropdownContainer = targetNavItem.closest('.nav-dropdown');
          if (dropdownContainer) {
            // For dropdown items, calculate position relative to container
            const actualLeft = (dropdownContainer as HTMLElement).offsetLeft + targetNavItem.offsetLeft;
            navIndicator.style.width = `${targetNavItem.offsetWidth - 32}px`;
            navIndicator.style.left = `${actualLeft + 12}px`;
          } else {
            navIndicator.style.width = `${targetNavItem.offsetWidth - 32}px`;
            navIndicator.style.left = `${targetNavItem.offsetLeft + 12}px`;
          }
          navIndicator.style.opacity = '1';
        }

        header?.classList.add('visible');
      } else if (sectionId === 'contact') {
        // Ocultar el indicador y el header solo en la sección de contacto
        activeNavItem = null;
        if (navIndicator) {
          navIndicator.style.opacity = '0';
        }
        header?.classList.remove('visible');
      } else {
        // Si no se detecta sección activa (por scroll intermedio), mantener el último estado
        if (activeNavItem && navIndicator) {
          const activeDropdownContainer = activeNavItem.closest('.nav-dropdown');
          if (activeDropdownContainer) {
            const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + activeNavItem.offsetLeft;
            navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
            navIndicator.style.left = `${actualLeft + 12}px`;
          } else {
            navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
            navIndicator.style.left = `${activeNavItem.offsetLeft + 12}px`;
          }
          navIndicator.style.opacity = '1';
        }
      }
    }
    
    // Hover en elementos del menú
    navItems.forEach(item => {
      const navLink = item as HTMLElement;
      const isProjectsItem = navLink.closest('.nav-dropdown') !== null;
      
      // For Projects item with dropdown, we need to handle hover on the parent
      if (isProjectsItem) {
        const dropdownContainer = navLink.closest('.nav-dropdown') as HTMLElement;
        console.log('Projects item detected:', {
          navLink,
          dropdownContainer,
          navLinkText: navLink.textContent?.trim(),
          navLinkOffsetWidth: navLink.offsetWidth,
          navLinkOffsetLeft: navLink.offsetLeft,
          dropdownOffsetWidth: dropdownContainer.offsetWidth,
          dropdownOffsetLeft: dropdownContainer.offsetLeft
        });
        
        dropdownContainer.addEventListener('mouseenter', () => {
          if (!isMenuOpen && navIndicator) {
            // For dropdown items, we need to use the container's offsetLeft since the link is positioned relative to it
            const actualLeft = dropdownContainer.offsetLeft + navLink.offsetLeft;
            console.log('Projects hover - positioning:', {
              calculatedWidth: navLink.offsetWidth - 32,
              calculatedLeft: actualLeft + 12,
              navLinkOffsetLeft: navLink.offsetLeft,
              dropdownOffsetLeft: dropdownContainer.offsetLeft,
              actualLeft: actualLeft,
              navLinkBounds: navLink.getBoundingClientRect(),
              dropdownBounds: dropdownContainer.getBoundingClientRect(),
              navIndicator
            });
            // Use the nav link inside the dropdown for positioning
            navIndicator.style.width = `${navLink.offsetWidth - 32}px`;
            navIndicator.style.left = `${actualLeft + 12}px`;
            navIndicator.style.opacity = '1';
            navLink.classList.add('nav-hover');
          }
        });
        
        dropdownContainer.addEventListener('mouseleave', () => {
          if (!isMenuOpen && navIndicator) {
            navLink.classList.remove('nav-hover');
            
            if (activeNavItem) {
              const activeDropdownContainer = activeNavItem.closest('.nav-dropdown');
              if (activeDropdownContainer) {
                const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + activeNavItem.offsetLeft;
                navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
                navIndicator.style.left = `${actualLeft + 12}px`;
              } else {
                navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
                navIndicator.style.left = `${activeNavItem.offsetLeft + 12}px`;
              }
              navIndicator.style.opacity = '1';
            } else {
              navIndicator.style.opacity = '0';
            }
          }
        });
      } else {
        // Regular nav items without dropdown
        console.log('Regular nav item:', {
          navLink,
          navLinkText: navLink.textContent?.trim(),
          offsetWidth: navLink.offsetWidth,
          offsetLeft: navLink.offsetLeft
        });
        
        navLink.addEventListener('mouseenter', () => {
          if (!isMenuOpen && navIndicator) {
            console.log('Regular item hover - positioning:', {
              item: navLink.textContent?.trim(),
              calculatedWidth: navLink.offsetWidth - 32,
              calculatedLeft: navLink.offsetLeft + 12,
              bounds: navLink.getBoundingClientRect()
            });
            navIndicator.style.width = `${navLink.offsetWidth - 32}px`;
            navIndicator.style.left = `${navLink.offsetLeft + 12}px`;
            navIndicator.style.opacity = '1';
            navLink.classList.add('nav-hover');
          }
        });
        
        navLink.addEventListener('mouseleave', () => {
          if (!isMenuOpen && navIndicator) {
            navLink.classList.remove('nav-hover');
            
            if (activeNavItem) {
              const activeDropdownContainer = activeNavItem.closest('.nav-dropdown');
              if (activeDropdownContainer) {
                const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + activeNavItem.offsetLeft;
                navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
                navIndicator.style.left = `${actualLeft + 12}px`;
              } else {
                navIndicator.style.width = `${activeNavItem.offsetWidth - 32}px`;
                navIndicator.style.left = `${activeNavItem.offsetLeft + 12}px`;
              }
              navIndicator.style.opacity = '1';
            } else {
              navIndicator.style.opacity = '0';
            }
          }
        });
      }
    });
    
    // Scroll suave a secciones
    allNavLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const targetHref = link.getAttribute('href');
        if (!targetHref) return;
        
        // Check if it's a hash link on the same page
        const isHashLink = targetHref.startsWith('#');
        const isHashLinkToOtherPage = targetHref.includes('/#');
        
        // Only intercept hash links on the same page
        if (!isHashLink && !isHashLinkToOtherPage) return;
        
        // If it's a hash link to another page, let it navigate normally
        if (isHashLinkToOtherPage) return;
        
        e.preventDefault();
        
        if (isMenuOpen) toggleMobileMenu();
        
        const targetIdClean = targetHref.substring(1);
        disableIndicatorUpdate = true;
        
        navItems.forEach(item => {
          item.classList.remove('nav-active');
          if (item.getAttribute('href') === targetHref) {
            item.classList.add('nav-active');
            if (navIndicator) {
              navIndicator.style.width = `${(item as HTMLElement).offsetWidth - 32}px`;
              navIndicator.style.left = `${(item as HTMLElement).offsetLeft + 12}px`;
              navIndicator.style.opacity = '1';
              activeNavItem = item as HTMLElement;
            }
          }
        });
        
        if (targetIdClean === 'home') {
          // Use smooth scrolling for a consistent experience
          smoothScrollTo(0, 2000);
        } else {
          const targetSection = document.querySelector(targetHref);
          if (targetSection && header) {
            const adjustAttr = link.getAttribute('data-scroll-adjust');
            const customAdjust = adjustAttr ? parseInt(adjustAttr) : 0;
            const headerHeight = header.offsetHeight;
            const targetPosition = targetSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - customAdjust;
            
            // Improved smooth scrolling
            smoothScrollTo(targetPosition, 2000);
          }
        }
        
        setTimeout(() => {
          disableIndicatorUpdate = false;
        }, 2000);
      });
    });
    
    // Helper function for smoother scrolling
    function smoothScrollTo(targetPosition: number, duration: number) {
      const startPosition = window.pageYOffset;
      const distance = targetPosition - startPosition;
      let startTime: number | null = null;
      
      function animation(currentTime: number) {
        if (startTime === null) startTime = currentTime;
        const timeElapsed = currentTime - startTime;
        const progress = Math.min(timeElapsed / duration, 1);
        const ease = easeInOutCubic(progress);
        
        window.scrollTo(0, startPosition + distance * ease);
        
        if (timeElapsed < duration) {
          requestAnimationFrame(animation);
        }
      }
      
      // Easing function for smoother acceleration and deceleration
      function easeInOutCubic(t: number) {
        return t < 0.5 
          ? 4 * t * t * t 
          : 1 - Math.pow(-2 * t + 2, 3) / 2;
      }
      
      requestAnimationFrame(animation);
    }
    
    // Activar enlaces según la sección visible
    function setActiveNavItem() {
      if (disableIndicatorUpdate || !header) return;

      // Get all sections that have IDs
      const sections = document.querySelectorAll('section[id]');
      // Adjust scroll position to account for header height and provide some buffer
      let scrollPosition = window.scrollY + header.offsetHeight;
      let foundActiveSection = false;
      
      // First section (home) special handling - make it active for the first viewport height
      const firstSection = document.querySelector('section#home') || document.querySelector('section:first-of-type');
      if (firstSection && scrollPosition < (firstSection as HTMLElement).offsetHeight) {
        updateIndicatorBySection('home');
        return;
      }
      
      // Check each section
      sections.forEach(section => {
        const sectionTop = (section as HTMLElement).offsetTop - header.offsetHeight; // Account for fixed header
        const sectionHeight = (section as HTMLElement).offsetHeight;
        const sectionId = section.getAttribute('id');
        
        // Check if current scroll position is within this section
        if (sectionId && 
            scrollPosition >= sectionTop && 
            scrollPosition < sectionTop + sectionHeight) {
          updateIndicatorBySection(sectionId);
          foundActiveSection = true;
        }
      });
      
      // Default to home if no section is found active
      if (!foundActiveSection) {
        updateIndicatorBySection('home');
      }
    }
    
    // Efectos de scroll
    function handleScroll() {
      if (!header) return;
      
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
      
      setActiveNavItem();
      // Show or hide the header based on hero visibility
      toggleHeaderVisibility();
    }
    
    // Toggle del menú móvil
    function toggleMobileMenu() {
      if (!mobileMenu || !mobileToggle || !burgerIcon) return;
      
      isMenuOpen = !isMenuOpen;
      mobileMenu.setAttribute('aria-hidden', String(!isMenuOpen));
      mobileToggle.setAttribute('aria-expanded', String(isMenuOpen));
      
      if (isMenuOpen) {
        mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
        mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
        document.body.style.overflow = 'hidden';
        
        // Reiniciar las animaciones de los elementos del menú
        const mobileNavItems = document.querySelectorAll('.mobile-nav-item');
        mobileNavItems.forEach((item, index) => {
          item.classList.remove('animated');
          void (item as HTMLElement).offsetWidth; // Forzar reflow
          (item as HTMLElement).style.animationDelay = `${index * 0.1}s`;
          item.classList.add('animated');
        });
      } else {
        mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
        mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    }
    
    if (mobileToggle) {
      mobileToggle.addEventListener('click', toggleMobileMenu);
    }

    if (mobileClose) {
      mobileClose.addEventListener('click', toggleMobileMenu);
    }
    
    // Cerrar menú al hacer clic en un enlace
    const mobileLinks = mobileMenu?.querySelectorAll('a');
    mobileLinks?.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Guardar referencias antes de cerrar el menú
        const targetId = link.getAttribute('href');
        if (!targetId || !header) return;
        
        const targetIdClean = targetId.substring(1);
        const adjustAttr = link.getAttribute('data-scroll-adjust');
        const customAdjust = adjustAttr ? parseInt(adjustAttr) : 0;
        
        // Cerrar el menú con un pequeño retraso para que se vea la animación
        if (isMenuOpen) {
          // Añadir clase de animación de salida
          link.classList.add('clicked');
          
          // Retrasar el cierre del menú para permitir que se vea la animación
          setTimeout(() => {
            toggleMobileMenu();
            
            // Navegar después de cerrar el menú
            setTimeout(() => {
              if (targetIdClean === 'home') {
                // Use smooth scrolling for a consistent experience
                smoothScrollTo(0, 800);
              } else {
                const targetSection = document.querySelector(targetId);
                if (targetSection) {
                  const headerHeight = header.offsetHeight;
                  const targetPosition = targetSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - customAdjust;
                  
                  // Use smooth scrolling for direct navigation too
                  smoothScrollTo(targetPosition, 1000);
                }
              }
            }, 300); // Retraso para la navegación después de cerrar el menú
          }, 200); // Retraso para cerrar el menú
        } else {
          // Si el menú ya está cerrado, navegar directamente
          if (targetIdClean === 'home') {
            // Use smooth scrolling for a consistent experience
            smoothScrollTo(0, 800);
          } else {
            const targetSection = document.querySelector(targetId);
            if (targetSection) {
              const headerHeight = header.offsetHeight;
              const targetPosition = targetSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - customAdjust;
              
              // Use smooth scrolling for direct navigation too
              smoothScrollTo(targetPosition, 1000);
            }
          }
        }
      });
    });
    
    // Add event listener for contact buttons (desktop and mobile)
    const contactButtons = document.querySelectorAll('a[href="#contact"]');
    contactButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (isMenuOpen) toggleMobileMenu();
        
        const contactSection = document.querySelector('#contact');
        if (contactSection && header) {
          const adjustAttr = button.getAttribute('data-scroll-adjust');
          const customAdjust = adjustAttr ? parseInt(adjustAttr) : 0;
          const headerHeight = header.offsetHeight;
          const targetPosition = contactSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - customAdjust;
            
          // Use the same smooth scrolling function
          smoothScrollTo(targetPosition, 2000);
        }
      });
    });
    
    // Inicialización
    handleScroll();
    // Ensure correct visibility state on initial load
    toggleHeaderVisibility();
    
    // Force Home to be active on initial page load if on main page
    if (heroSection) {
      updateIndicatorBySection('home');
    }
    
    // Event listeners
    window.addEventListener('scroll', handleScroll);
    
    // Manejar el evento de redimensionamiento de ventana para actualizar el indicador
    window.addEventListener('resize', () => {
      if (activeNavItem && navIndicator) {
        navIndicator.style.width = `${activeNavItem.offsetWidth - 40}px`;
        navIndicator.style.left = `${activeNavItem.offsetLeft + 20}px`;
      }
    });
    
    // Manejar el evento de orientación para dispositivos móviles
    window.addEventListener('orientationchange', () => {
      setTimeout(() => {
        if (activeNavItem && navIndicator) {
          navIndicator.style.width = `${activeNavItem.offsetWidth - 40}px`;
          navIndicator.style.left = `${activeNavItem.offsetLeft + 20}px`;
        }
      }, 200);
    });
    
    if (logoLink) {
      logoLink.addEventListener('click', (e) => {
        const logoHref = logoLink.getAttribute('href');
        // Only prevent default for same-page navigation
        if (window.location.pathname === logoHref || logoHref === '/') {
          e.preventDefault();
          // Use the smooth scroll function for the logo as well
          smoothScrollTo(0, 2000);
        }
        // Otherwise, let the browser handle the navigation
      });
    }
    
    // Detectar si es un dispositivo táctil
    const isTouchDevice = () => {
      return 'ontouchstart' in window || ('maxTouchPoints' in navigator && (navigator as any).maxTouchPoints > 0);
    };
    
    // Si es un dispositivo táctil, ajustar el comportamiento del menú
    if (isTouchDevice()) {
      document.documentElement.classList.add('touch-device');
    }
    
    // Handle projects expansion
    if (projectsNavItem && projectsExpansion) {
      function showExpansion() {
        if (expansionTimeout) {
          clearTimeout(expansionTimeout);
          expansionTimeout = null;
        }
        projectsExpansion.classList.add('expanded');
        projectsNavItem.classList.add('expanded');
      }
      
      function hideExpansion() {
        expansionTimeout = window.setTimeout(() => {
          projectsExpansion.classList.remove('expanded');
          projectsNavItem.classList.remove('expanded');
        }, 200);
      }
      
      projectsNavItem.addEventListener('mouseenter', showExpansion);
      projectsNavItem.addEventListener('mouseleave', hideExpansion);
      projectsExpansion.addEventListener('mouseenter', showExpansion);
      projectsExpansion.addEventListener('mouseleave', hideExpansion);
    }
  });
</script>

