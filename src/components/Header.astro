---
interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

import locales from '../../public/locales/en.json';
const t = locales;

import { projects } from '../data/projects';
import LanguageSelector from './LanguageSelector.astro';
---

<header id="main-header" class="fixed top-0 left-0 w-full bg-white transition-all duration-300 py-6 translate-y-[-100%] shadow-lg opacity-0 z-50 sm:px-12">
    <nav class="flex flex-row items-center justify-between font-medium text-white" id="main-nav">
      <!-- Logo and navigation container -->

      <a href={`/${lang}`} class="logo-link flex items-center font-bold text-2xl lg:text-3xl">
        <img src="/full_logo.png" width="200">
      </a>

      <div class="flex items-center gap-8">
        <!-- Desktop navigation -->
        <ul class="hidden md:flex items-center text-black text-[18px] font-semibold lg:gap-8 md:gap-6 relative tracking-wider">
          <li><a href={`/${lang}/#home`} class="nav-item hover:text-gray-300 transition-colors duration-200">Inicio</a></li>
          <li><a href={`/${lang}/#services`} class="nav-item hover:text-gray-300 transition-colors duration-200">Servicios</a></li>
          <li class="nav-dropdown relative">
            <button class="nav-item hover:text-gray-300   text-[18px] font-semibold  transition-colors duration-200 cursor-pointer flex items-center gap-1">
              Proyectos
              <svg class="w-3 h-3 mt-0.5 nav-dropdown-arrow transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
          </li>
          <li><a href={`/${lang}/#about`} class="nav-item hover:text-gray-300 transition-colors duration-200">Nosotros</a></li>
          <li><a href={`/${lang}/#awards`} class="nav-item hover:text-gray-300 transition-colors duration-200">Premios</a></li>
          <li><a href={`/${lang}/#contact`} class="nav-item hover:text-gray-300 transition-colors duration-200">Contacto</a></li>
        </ul>
        
        <!-- Navigation indicator line -->
        <div id="nav-indicator" class="absolute bottom-0 h-[2px] bg-black opacity-0 transition-all duration-300 ease-out"></div>
      </div>
      
      <!-- Right side: Language selector -->
      <div class="flex items-center gap-4 transition-opacity duration-300">
        <div id="language-selector-wrapper">
          <LanguageSelector currentLang={lang} />
        </div>
        
        <!-- Mobile menu button -->
        <button id="mobile-toggle" class="md:hidden flex items-center justify-center w-10 h-10 relative" aria-label="Toggle menu">
          <div class="burger-icon">
            <span></span>
            <span></span>
            <span></span>
          </div>
        </button>
      </div>
    </nav>
  
  <!-- Projects expansion panel -->
  <div class="projects-expansion absolute left-0 right-0 top-full bg-white shadow-lg overflow-hidden">
    <div class=" sm:px-8 pt-2 pb-3">
      <div class="flex flex-row items-center justify-start gap-8 max-w-6xl">
        {Object.values(projects).map((project) => (
          <a href={`/${lang}/projects/${project.id}`} class="group block transition-all duration-200 overflow-hidden">
            <div class="p-4">
              <h3 class="font-semibold text-black  transition-colors">{project.title}</h3>
              <p class="text-sm text-gray-600 mt-1">{project.category}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 bg-black z-[60] flex items-center justify-center">
  <button id="mobile-close" class="absolute top-4 right-4 text-white p-2" aria-label="Close menu">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  
  <nav class="text-center">
    <ul class="space-y-6">
      <li class="mobile-nav-item"><a href={`/${lang}/#home`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Inicio</a></li>
      <li class="mobile-nav-item"><a href={`/${lang}/#services`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Servicios</a></li>
      <li class="mobile-nav-item"><a href={`/${lang}/projects`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Proyectos</a></li>
      <li class="mobile-nav-item"><a href={`/${lang}/#about`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Nosotros</a></li>
      <li class="mobile-nav-item"><a href={`/${lang}/#awards`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Premios</a></li>
      <li class="mobile-nav-item"><a href={`/${lang}/#contact`} class="text-4xl font-bold text-white hover:text-gray-300 transition-colors mobile-nav-link">Contacto</a></li>
    </ul>
  </nav>
</div>

<script>
// Type definitions
interface TouchedWindow extends Window {
  ontouchstart?: any;
}

// Global state
interface HeaderState {
  header: HTMLElement | null;
  heroSection: HTMLElement | null;
  navIndicator: HTMLElement | null;
  activeNavItem: HTMLElement | null;
  disableIndicatorUpdate: boolean;
  isMenuOpen: boolean;
  projectsExpansion: HTMLElement | null;
  projectsNavItem: Element | null;
  expansionTimeout: number | null;
  scrollListener: (() => void) | null;
  resizeListener: (() => void) | null;
}

const state: HeaderState = {
  header: null,
  heroSection: null,
  navIndicator: null,
  activeNavItem: null,
  disableIndicatorUpdate: false,
  isMenuOpen: false,
  projectsExpansion: null,
  projectsNavItem: null,
  expansionTimeout: null,
  scrollListener: null,
  resizeListener: null
};

// Clean up existing listeners
function cleanupListeners() {
  if (state.scrollListener) {
    window.removeEventListener('scroll', state.scrollListener);
    state.scrollListener = null;
  }
  if (state.resizeListener) {
    window.removeEventListener('resize', state.resizeListener);
    state.resizeListener = null;
  }
}

// Initialize header
function initializeHeader() {
  cleanupListeners();
  
  // Get DOM elements
  state.header = document.getElementById('main-header');
  state.heroSection = document.querySelector('section#home') as HTMLElement | null;
  state.navIndicator = document.getElementById('nav-indicator');
  state.projectsExpansion = document.querySelector('.projects-expansion') as HTMLElement;
  state.projectsNavItem = document.querySelector('.nav-dropdown');
  
  // Reset state
  state.activeNavItem = null;
  state.disableIndicatorUpdate = false;
  state.expansionTimeout = null;
  
  // Show header on project pages
  if (!state.heroSection && state.header) {
    state.header.classList.add('visible');
  }
  
  // Reset nav indicator
  if (state.navIndicator) {
    state.navIndicator.style.opacity = '0';
  }
  
  // Set up all functionality
  setupToggleHeaderVisibility();
  setupNavigation();
  setupMobileMenu();
  setupProjectsDropdown();
  setupScrollHandlers();
  
  // Initial check
  if (state.heroSection) {
    toggleHeaderVisibility();
  }
  setActiveNavItem();
}

// Toggle header visibility based on scroll
function toggleHeaderVisibility() {
  if (!state.header) return;
  
  if (!state.heroSection) {
    state.header.classList.add('visible');
    return;
  }

  const heroBottom = state.heroSection.getBoundingClientRect().bottom;
  const logoContainer = document.getElementById('hero-logo-container');

  if (heroBottom <= state.header.offsetHeight + 200) {
    state.header.classList.add('visible');
    if (logoContainer) logoContainer.style.opacity = '0';
  } else {
    state.header.classList.remove('visible');
    if (logoContainer) logoContainer.style.opacity = '1';
  }
}

// Setup toggle header visibility
function setupToggleHeaderVisibility() {
  if (!state.heroSection) return;
  
  state.scrollListener = () => {
    toggleHeaderVisibility();
    setActiveNavItem();
  };
  
  window.addEventListener('scroll', state.scrollListener);
}

// Update nav indicator
function updateIndicatorBySection(sectionId: string) {
  const targetNavItem = document.querySelector(`nav .nav-item[href="#${sectionId}"]`) as HTMLElement;
  
  if (targetNavItem) {
    state.activeNavItem = targetNavItem;

    if (state.navIndicator) {
      const dropdownContainer = targetNavItem.closest('.nav-dropdown');
      if (dropdownContainer) {
        const actualLeft = (dropdownContainer as HTMLElement).offsetLeft + targetNavItem.offsetLeft;
        state.navIndicator.style.width = `${targetNavItem.offsetWidth - 32}px`;
        state.navIndicator.style.left = `${actualLeft + 12}px`;
      } else {
        state.navIndicator.style.width = `${targetNavItem.offsetWidth - 32}px`;
        state.navIndicator.style.left = `${targetNavItem.offsetLeft + 12}px`;
      }
      state.navIndicator.style.opacity = '1';
    }

    state.header?.classList.add('visible');
  } else if (sectionId === 'contact') {
    state.activeNavItem = null;
    if (state.navIndicator) {
      state.navIndicator.style.opacity = '0';
    }
    state.header?.classList.remove('visible');
  } else if (state.activeNavItem && state.navIndicator) {
    const activeDropdownContainer = state.activeNavItem.closest('.nav-dropdown');
    if (activeDropdownContainer) {
      const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + state.activeNavItem.offsetLeft;
      state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
      state.navIndicator.style.left = `${actualLeft + 12}px`;
    } else {
      state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
      state.navIndicator.style.left = `${state.activeNavItem.offsetLeft + 12}px`;
    }
    state.navIndicator.style.opacity = '1';
  }
}

// Set active nav item based on scroll
function setActiveNavItem() {
  if (state.disableIndicatorUpdate || !state.header) return;

  const sections = document.querySelectorAll('section[id]');
  let scrollPosition = window.scrollY + state.header.offsetHeight;
  let foundActiveSection = false;
  
  const firstSection = document.querySelector('section#home') || document.querySelector('section:first-of-type');
  if (firstSection && scrollPosition < (firstSection as HTMLElement).offsetHeight) {
    updateIndicatorBySection('home');
    return;
  }
  
  sections.forEach(section => {
    const sectionTop = (section as HTMLElement).offsetTop - state.header!.offsetHeight;
    const sectionHeight = (section as HTMLElement).offsetHeight;
    const sectionId = section.getAttribute('id');
    
    if (sectionId && 
        scrollPosition >= sectionTop && 
        scrollPosition < sectionTop + sectionHeight) {
      updateIndicatorBySection(sectionId);
      foundActiveSection = true;
    }
  });
  
  if (!foundActiveSection) {
    updateIndicatorBySection('home');
  }
}

// Setup navigation
function setupNavigation() {
  const navItems = document.querySelectorAll('.nav-item');
  const allNavLinks = document.querySelectorAll('nav .nav-item');
  const logoLink = document.querySelector('.logo-link');
  
  // Nav item hover
  navItems.forEach(item => {
    const navLink = item as HTMLElement;
    const isProjectsItem = navLink.closest('.nav-dropdown') !== null;
    
    if (isProjectsItem) {
      const dropdownParent = navLink.closest('.nav-dropdown') as HTMLElement;
      dropdownParent.addEventListener('mouseenter', () => {
        if (!state.navIndicator || state.disableIndicatorUpdate) return;
        state.navIndicator.style.width = `${navLink.offsetWidth - 32}px`;
        state.navIndicator.style.left = `${dropdownParent.offsetLeft + 12}px`;
        state.navIndicator.style.opacity = '1';
      });
      
      dropdownParent.addEventListener('mouseleave', () => {
        if (!state.navIndicator || !state.activeNavItem || state.disableIndicatorUpdate) return;
        const activeDropdownContainer = state.activeNavItem.closest('.nav-dropdown');
        if (activeDropdownContainer) {
          const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + state.activeNavItem.offsetLeft;
          state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
          state.navIndicator.style.left = `${actualLeft + 12}px`;
        } else {
          state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
          state.navIndicator.style.left = `${state.activeNavItem.offsetLeft + 12}px`;
        }
        state.navIndicator.style.opacity = '1';
      });
    } else {
      navLink.addEventListener('mouseenter', () => {
        if (!state.navIndicator || state.disableIndicatorUpdate) return;
        state.navIndicator.style.width = `${navLink.offsetWidth - 32}px`;
        state.navIndicator.style.left = `${navLink.offsetLeft + 12}px`;
        state.navIndicator.style.opacity = '1';
      });
      
      navLink.addEventListener('mouseleave', () => {
        if (!state.navIndicator || !state.activeNavItem || state.disableIndicatorUpdate) return;
        const activeDropdownContainer = state.activeNavItem.closest('.nav-dropdown');
        if (activeDropdownContainer) {
          const actualLeft = (activeDropdownContainer as HTMLElement).offsetLeft + state.activeNavItem.offsetLeft;
          state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
          state.navIndicator.style.left = `${actualLeft + 12}px`;
        } else {
          state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 32}px`;
          state.navIndicator.style.left = `${state.activeNavItem.offsetLeft + 12}px`;
        }
        state.navIndicator.style.opacity = '1';
      });
    }
  });
  
  // Nav link clicks
  allNavLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (!href || !href.startsWith('#')) return;
      
      e.preventDefault();
      state.disableIndicatorUpdate = true;
      
      const targetIdClean = href.substring(1);
      const targetHref = `#${targetIdClean}`;
      
      allNavLinks.forEach(item => {
        item.classList.remove('nav-active');
        if (item.getAttribute('href') === targetHref) {
          item.classList.add('nav-active');
          if (state.navIndicator) {
            state.navIndicator.style.width = `${(item as HTMLElement).offsetWidth - 32}px`;
            state.navIndicator.style.left = `${(item as HTMLElement).offsetLeft + 12}px`;
            state.navIndicator.style.opacity = '1';
            state.activeNavItem = item as HTMLElement;
          }
        }
      });
      
      if (targetIdClean === 'home') {
        smoothScrollTo(0, 2000);
      } else {
        const targetSection = document.querySelector(targetHref);
        if (targetSection && state.header) {
          const adjustAttr = link.getAttribute('data-scroll-adjust');
          const customAdjust = adjustAttr ? parseInt(adjustAttr) : 0;
          const headerHeight = state.header.offsetHeight;
          const targetPosition = targetSection.getBoundingClientRect().top + window.pageYOffset - headerHeight - customAdjust;
          smoothScrollTo(targetPosition, 2000);
        }
      }
      
      setTimeout(() => {
        state.disableIndicatorUpdate = false;
      }, 2000);
    });
  });
  
  // Logo link
  if (logoLink) {
    logoLink.addEventListener('click', (e) => {
      const logoHref = logoLink.getAttribute('href');
      if (window.location.pathname === logoHref || logoHref === '/') {
        e.preventDefault();
        smoothScrollTo(0, 2000);
      }
    });
  }
}

// Smooth scroll helper
function smoothScrollTo(targetPosition: number, duration: number) {
  const startPosition = window.pageYOffset;
  const distance = targetPosition - startPosition;
  let startTime: number | null = null;
  
  function animation(currentTime: number) {
    if (startTime === null) startTime = currentTime;
    const timeElapsed = currentTime - startTime;
    const progress = Math.min(timeElapsed / duration, 1);
    const ease = easeInOutCubic(progress);
    
    window.scrollTo(0, startPosition + distance * ease);
    
    if (timeElapsed < duration) {
      requestAnimationFrame(animation);
    }
  }
  
  function easeInOutCubic(t: number) {
    return t < 0.5 
      ? 4 * t * t * t 
      : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }
  
  requestAnimationFrame(animation);
}

// Setup mobile menu
function setupMobileMenu() {
  const mobileToggle = document.getElementById('mobile-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileClose = document.getElementById('mobile-close');
  const burgerIcon = document.querySelector('.burger-icon');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
  
  if (mobileToggle && mobileMenu && mobileClose && burgerIcon) {
    mobileToggle.addEventListener('click', () => {
      state.isMenuOpen = true;
      mobileMenu.classList.add('active');
      document.body.classList.add('menu-open');
      burgerIcon.classList.add('active');
    });
    
    mobileClose.addEventListener('click', () => {
      state.isMenuOpen = false;
      mobileMenu.classList.remove('active');
      document.body.classList.remove('menu-open');
      burgerIcon.classList.remove('active');
    });
    
    mobileNavLinks.forEach(link => {
      link.addEventListener('click', () => {
        state.isMenuOpen = false;
        mobileMenu.classList.remove('active');
        document.body.classList.remove('menu-open');
        burgerIcon.classList.remove('active');
      });
    });
  }
}

// Setup projects dropdown
function setupProjectsDropdown() {
  if (!state.projectsNavItem || !state.projectsExpansion) return;
  
  const triggerEl = state.projectsNavItem as HTMLElement; // the <li.nav-dropdown>
  const panelEl = state.projectsExpansion as HTMLElement; // the .projects-expansion container
  
  let hideTimer: number | null = null;
  
  function openPanel() {
    if (hideTimer) {
      clearTimeout(hideTimer);
      hideTimer = null;
    }
    panelEl.classList.add('expanded');
    triggerEl.classList.add('expanded');
  }
  
  function scheduleClose() {
    if (hideTimer) {
      clearTimeout(hideTimer);
    }
    // Wait a bit so the user can move the pointer from the trigger into the panel without collapse.
    hideTimer = window.setTimeout(() => {
      // If either the trigger or the panel is currently hovered or focused, keep it open.
      const stillHovering = triggerEl.matches(':hover') || panelEl.matches(':hover');
      const stillFocused = triggerEl.contains(document.activeElement) || panelEl.contains(document.activeElement);
      if (stillHovering || stillFocused) return;
      panelEl.classList.remove('expanded');
      triggerEl.classList.remove('expanded');
      hideTimer = null;
    }, 250);
  }
  
  // Pointer interactions
  triggerEl.addEventListener('pointerenter', openPanel);
  triggerEl.addEventListener('pointerleave', scheduleClose);
  panelEl.addEventListener('pointerenter', openPanel);
  panelEl.addEventListener('pointerleave', scheduleClose);
  
  // Keyboard accessibility: open on focus within trigger; close when focus leaves both.
  triggerEl.addEventListener('focusin', openPanel);
  panelEl.addEventListener('focusin', openPanel);
  triggerEl.addEventListener('focusout', scheduleClose);
  panelEl.addEventListener('focusout', scheduleClose);
  
  // Touch devices: tap toggles open/close.
  triggerEl.addEventListener('click', (e) => {
    // Prevent default button behavior from immediately navigating.
    // Instead, toggle panel; second tap on the same control or a tap on a project link will navigate.
    const isExpanded = triggerEl.classList.contains('expanded');
    if (!isExpanded) {
      e.preventDefault();
      openPanel();
    } else {
      // allow normal navigation on second tap
      scheduleClose();
    }
  }, { capture: true });
}

// Setup scroll handlers
function setupScrollHandlers() {
  // Resize handler
  state.resizeListener = () => {
    if (state.activeNavItem && state.navIndicator) {
      state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 40}px`;
      state.navIndicator.style.left = `${state.activeNavItem.offsetLeft + 20}px`;
    }
  };
  window.addEventListener('resize', state.resizeListener);
  
  // Orientation change
  window.addEventListener('orientationchange', () => {
    setTimeout(() => {
      if (state.activeNavItem && state.navIndicator) {
        state.navIndicator.style.width = `${state.activeNavItem.offsetWidth - 40}px`;
        state.navIndicator.style.left = `${state.activeNavItem.offsetLeft + 20}px`;
      }
    }, 200);
  });
  
  // Touch device detection
  const isTouchDevice = () => {
    return 'ontouchstart' in window || ('maxTouchPoints' in navigator && (navigator as any).maxTouchPoints > 0);
  };
  
  if (isTouchDevice()) {
    document.documentElement.classList.add('touch-device');
  }
}

// Initialize on DOMContentLoaded
document.addEventListener('DOMContentLoaded', initializeHeader);

// Re-initialize on Astro page navigation
document.addEventListener('astro:page-load', initializeHeader);
</script>

<style>
  #main-header {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 500;
    transform: translateY(-100%);
    opacity: 0;
  }
  
  #main-header.visible {
    transform: translateY(0);
    opacity: 1;
  }
  
  #main-nav {
    position: relative;
  }
  
  #nav-indicator {
    position: absolute;
    bottom: -4px;
    height: 2px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  .nav-dropdown-arrow {
    transition: transform 0.2s ease;
  }
  
  .nav-dropdown.expanded .nav-dropdown-arrow {
    transform: rotate(180deg);
  }
  
  .projects-expansion {
    max-height: 0;
    transition: max-height 0.6s ease-out;
  }
  
  .projects-expansion.expanded {
    max-height: 500px;
  }
  
  #mobile-menu {
    transform: translateX(100%);
    transition: transform 0.3s ease;
  }
  
  #mobile-menu.active {
    transform: translateX(0);
  }
  
  .mobile-nav-item {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
  }
  
  #mobile-menu.active .mobile-nav-item {
    opacity: 1;
    transform: translateY(0);
  }
  
  #mobile-menu.active .mobile-nav-item:nth-child(1) { transition-delay: 0.1s; }
  #mobile-menu.active .mobile-nav-item:nth-child(2) { transition-delay: 0.2s; }
  #mobile-menu.active .mobile-nav-item:nth-child(3) { transition-delay: 0.3s; }
  #mobile-menu.active .mobile-nav-item:nth-child(4) { transition-delay: 0.4s; }
  #mobile-menu.active .mobile-nav-item:nth-child(5) { transition-delay: 0.5s; }
  #mobile-menu.active .mobile-nav-item:nth-child(6) { transition-delay: 0.6s; }
  
  body.menu-open {
    overflow: hidden;
  }
  
  .burger-icon {
    width: 24px;
    height: 20px;
    position: relative;
    transform: rotate(0deg);
    transition: .5s ease-in-out;
    cursor: pointer;
  }
  
  .burger-icon span {
    display: block;
    position: absolute;
    height: 2px;
    width: 100%;
    background: white;
    opacity: 1;
    left: 0;
    transform: rotate(0deg);
    transition: .25s ease-in-out;
  }
  
  .burger-icon span:nth-child(1) {
    top: 0px;
  }
  
  .burger-icon span:nth-child(2) {
    top: 9px;
  }
  
  .burger-icon span:nth-child(3) {
    top: 18px;
  }
  
  .burger-icon.active span:nth-child(1) {
    top: 9px;
    transform: rotate(135deg);
  }
  
  .burger-icon.active span:nth-child(2) {
    opacity: 0;
    left: -60px;
  }
  
  .burger-icon.active span:nth-child(3) {
    top: 9px;
    transform: rotate(-135deg);
  }
  
  @media (max-width: 768px) {
    #main-header {
      padding: 1rem;
    }
  }
</style>